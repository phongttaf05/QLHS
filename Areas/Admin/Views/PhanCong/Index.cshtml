@model IEnumerable<QLHS.Models.PhanCongGiangDay>

@{
    ViewData["Title"] = "Quản Lý Phân Công Giảng Dạy";
    var dsHocKy = ViewBag.DanhSachHocKy as List<QLHS.Models.HocKy>;
    var dsLop = ViewBag.DanhSachLop as List<QLHS.Models.LopHoc>;
    var dsGiaoVien = ViewBag.DanhSachGiaoVien as List<QLHS.Models.GiaoVien>;
    var dsMonHoc = ViewBag.DanhSachMonHoc as List<QLHS.Models.MonHoc>;

    int selectedHocKyId = ViewBag.SelectedHocKyId ?? 0;
    var selectedHocKy = ViewBag.SelectedHocKy as QLHS.Models.HocKy;
    int? selectedLopId = ViewBag.SelectedLopId as int?;
    int? selectedGvId = ViewBag.SelectedGiaoVienId as int?;
    int? selectedMonId = ViewBag.SelectedMonId as int?;
}

@Html.AntiForgeryToken()

<!-- TIÊU ĐỀ & NÚT THÊM MỚI -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-primary mb-1">
            <i class="bi bi-journal-check me-2"></i>PHÂN CÔNG GIẢNG DẠY (LỚP – MÔN – GIÁO VIÊN)
        </h3>
        <p class="text-muted mb-0">Phân công giáo viên theo chuyên môn cho từng lớp–môn để làm đầu vào lập Thời khóa biểu (OR-Tools) và nhập điểm.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="ThoiKhoaBieu" asp-action="Index" class="btn btn-outline-primary fw-semibold">
            <i class="bi bi-calendar3-week me-1"></i>Sang Lập TKB
        </a>
        @if (selectedHocKyId > 0)
        {
            <button type="button" class="btn btn-primary fw-bold shadow-sm" onclick="openCreateModal()">
                <i class="bi bi-plus-circle me-1"></i>Thêm Phân Công
            </button>
        }
    </div>
</div>

<!-- 4 THẺ KPI -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-primary">
            <div class="card-body py-3">
                <div class="text-muted small fw-bold text-uppercase">Tổng phân công</div>
                <h3 class="fw-bold text-primary mb-0 mt-1">@ViewBag.TongPhanCong</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-success">
            <div class="card-body py-3">
                <div class="text-muted small fw-bold text-uppercase">Tổng tiết / tuần</div>
                <h3 class="fw-bold text-success mb-0 mt-1">@ViewBag.TongSoTiet</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-info">
            <div class="card-body py-3">
                <div class="text-muted small fw-bold text-uppercase">Số lớp đã phân công</div>
                <h3 class="fw-bold text-info mb-0 mt-1">@ViewBag.SoLopDaPhanCong</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-warning">
            <div class="card-body py-3">
                <div class="text-muted small fw-bold text-uppercase">Giáo viên tham gia</div>
                <h3 class="fw-bold text-warning mb-0 mt-1">@ViewBag.SoGiaoVienThamGia</h3>
            </div>
        </div>
    </div>
</div>

<!-- BỘ LỌC -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Học kỳ:</label>
                <select name="hocKyId" class="form-select form-select-sm fw-semibold" onchange="this.form.submit()">
                    @if (dsHocKy != null)
                    {
                        foreach (var hk in dsHocKy)
                        {
                            <option value="@hk.Id" selected="@(hk.Id == selectedHocKyId)">
                                @(hk.NamHoc?.TenNamHoc ?? "---") - Học kỳ @hk.SoHocKy
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Lớp học:</label>
                <select name="lopHocId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả lớp --</option>
                    @if (dsLop != null)
                    {
                        foreach (var l in dsLop)
                        {
                            <option value="@l.Id" selected="@(selectedLopId == l.Id)">Lớp @l.TenLop</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Giáo viên:</label>
                <select name="giaoVienId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả GV --</option>
                    @if (dsGiaoVien != null)
                    {
                        foreach (var g in dsGiaoVien)
                        {
                            <option value="@g.Id" selected="@(selectedGvId == g.Id)">@g.HoTen</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold small text-muted">Môn học:</label>
                <select name="monHocId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả môn --</option>
                    @if (dsMonHoc != null)
                    {
                        foreach (var m in dsMonHoc)
                        {
                            <option value="@m.Id" selected="@(selectedMonId == m.Id)">@m.TenMon</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-1">
                <a href="/Admin/PhanCong?hocKyId=@selectedHocKyId" class="btn btn-sm btn-outline-secondary w-100" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DANH SÁCH PHÂN CÔNG -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Lớp</th>
                        <th>Môn Học</th>
                        <th>Giáo Viên Phụ Trách</th>
                        <th class="text-center">Số Tiết/Tuần</th>
                        <th>Hiệu Lực</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var pc in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="fw-bold text-primary">Lớp @(pc.LopHoc?.TenLop ?? "---")</span>
                                    <div class="small text-muted">Khối @(pc.LopHoc?.KhoiLop?.SoKhoi ?? 0)</div>
                                </td>
                                <td class="fw-semibold text-dark">@(pc.MonHoc?.TenMon ?? "---")</td>
                                <td>
                                    <i class="bi bi-person-badge text-info me-1"></i>
                                    <span class="fw-bold">@(pc.GiaoVien?.HoTen ?? "Chưa gán")</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1">
                                        @(pc.SoTietTuan ?? 0) tiết
                                    </span>
                                </td>
                                <td class="small text-muted">
                                    @(pc.TuNgay?.ToString("dd/MM/yyyy") ?? "---") → @(pc.DenNgay?.ToString("dd/MM/yyyy") ?? "---")
                                </td>
                                <td class="text-end pe-3">
                                    <button type="button" class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(@pc.Id)" title="Sửa giáo viên / số tiết">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deletePhanCong(@pc.Id, 'Lớp @pc.LopHoc?.TenLop - @pc.MonHoc?.TenMon')" title="Xóa phân công">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Chưa có phân công giảng dạy nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL THÊM PHÂN CÔNG -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Thêm Phân Công Giảng Dạy</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="createForm">
                <div class="modal-body">
                    <input type="hidden" id="c_hocKyId" value="@selectedHocKyId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Lớp học <span class="text-danger">*</span></label>
                        <select id="c_lopHocId" class="form-select" onchange="autoFillSoTiet()" required>
                            <option value="">-- Chọn lớp --</option>
                            @if (dsLop != null)
                            {
                                foreach (var l in dsLop)
                                {
                                    <option value="@l.Id">Lớp @l.TenLop (Khối @(l.KhoiLop?.SoKhoi ?? 0)) - GVCN: @(l.GiaoVienChuNhiem?.HoTen ?? "Chưa có")</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Môn học <span class="text-danger">*</span></label>
                        <select id="c_monHocId" class="form-select" onchange="autoFillSoTiet()" required>
                            <option value="">-- Chọn môn học --</option>
                            @if (dsMonHoc != null)
                            {
                                foreach (var m in dsMonHoc)
                                {
                                    <option value="@m.Id">@m.TenMon</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Giáo viên giảng dạy <span class="text-danger">*</span></label>
                        <select id="c_giaoVienId" class="form-select" required>
                            <option value="">-- Chọn giáo viên --</option>
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Số tiết/tuần <span class="text-danger">*</span></label>
                            <input type="number" id="c_soTietTuan" class="form-control" min="1" max="15" value="2" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Từ ngày</label>
                            <input type="date" id="c_tuNgay" class="form-control" value="@(selectedHocKy?.TuNgay?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Đến ngày</label>
                            <input type="date" id="c_denNgay" class="form-control" value="@(selectedHocKy?.DenNgay?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-bold">Lưu Phân Công</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL SỬA PHÂN CÔNG -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Điều Chỉnh Phân Công Giảng Dạy</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm">
                <div class="modal-body">
                    <input type="hidden" id="e_id" />
                    <div class="alert alert-light border small mb-3">
                        <strong>Lớp:</strong> <span id="e_tenLop" class="text-primary fw-bold"></span> | <strong>Môn:</strong> <span id="e_tenMon" class="fw-bold"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Giáo viên giảng dạy <span class="text-danger">*</span></label>
                        <select id="e_giaoVienId" class="form-select" required></select>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Số tiết/tuần <span class="text-danger">*</span></label>
                            <input type="number" id="e_soTietTuan" class="form-control" min="1" max="15" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Từ ngày</label>
                            <input type="date" id="e_tuNgay" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Đến ngày</label>
                            <input type="date" id="e_denNgay" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning fw-bold">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- TOAST -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="pcToast" class="toast align-items-center text-bg-success border-0 shadow" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="pcToastMsg">Thành công!</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
const createModal = new bootstrap.Modal(document.getElementById('createModal'));
const editModal = new bootstrap.Modal(document.getElementById('editModal'));
const allTeachers = @Html.Raw(ViewBag.ChuyenMonJson ?? "[]");

function rebuildTeacherDropdown(selectId, monHocId, preferredGvId) {
    const sel = document.getElementById(selectId);
    const currentVal = preferredGvId || sel.value;
    const mId = parseInt(monHocId);

    sel.innerHTML = '<option value="">-- Chọn giáo viên --</option>';

    if (!mId) {
        allTeachers.forEach(gv => {
            const opt = document.createElement('option');
            opt.value = gv.id;
            opt.textContent = gv.hoTen;
            sel.appendChild(opt);
        });
    } else {
        const specialists = allTeachers.filter(gv => (gv.monHocIds || []).includes(mId));
        const others = allTeachers.filter(gv => !(gv.monHocIds || []).includes(mId));

        if (specialists.length > 0) {
            const grpSpec = document.createElement('optgroup');
            grpSpec.label = '★ Đúng chuyên môn môn này';
            specialists.forEach(gv => {
                const opt = document.createElement('option');
                opt.value = gv.id;
                opt.textContent = gv.hoTen;
                grpSpec.appendChild(opt);
            });
            sel.appendChild(grpSpec);
        }

        if (others.length > 0) {
            const grpOther = document.createElement('optgroup');
            grpOther.label = specialists.length > 0 ? 'Giáo viên khác (kiêm nhiệm / dạy thay)' : 'Danh sách giáo viên';
            others.forEach(gv => {
                const opt = document.createElement('option');
                opt.value = gv.id;
                opt.textContent = gv.hoTen;
                grpOther.appendChild(opt);
            });
            sel.appendChild(grpOther);
        }
    }

    if (currentVal) sel.value = currentVal;
}

function getToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]').value;
}

function showToast(msg, isError = false) {
    const el = document.getElementById('pcToast');
    document.getElementById('pcToastMsg').textContent = msg;
    el.classList.remove('text-bg-success', 'text-bg-danger');
    el.classList.add(isError ? 'text-bg-danger' : 'text-bg-success');
    new bootstrap.Toast(el, { delay: 2500 }).show();
}

function openCreateModal() {
    document.getElementById('createForm').reset();
    document.getElementById('c_soTietTuan').value = 2;
    rebuildTeacherDropdown('c_giaoVienId', 0, '');
    createModal.show();
}

function autoFillSoTiet() {
    const hkId = document.getElementById('c_hocKyId').value;
    const lopId = document.getElementById('c_lopHocId').value;
    const monId = document.getElementById('c_monHocId').value;

    rebuildTeacherDropdown('c_giaoVienId', monId, '');

    if (!hkId || !lopId || !monId) return;

    fetch(`/Admin/PhanCong/GetSoTietChuan?hocKyId=${hkId}&lopHocId=${lopId}&monHocId=${monId}`)
        .then(r => r.json())
        .then(res => {
            if (res.soTiet) document.getElementById('c_soTietTuan').value = res.soTiet;
            const mId = parseInt(monId);
            const gvcn = allTeachers.find(g => g.id === res.gvcnId);
            const specialists = allTeachers.filter(g => (g.monHocIds || []).includes(mId));

            if (gvcn && (gvcn.monHocIds || []).includes(mId)) {
                document.getElementById('c_giaoVienId').value = gvcn.id;
            } else if (specialists.length === 1) {
                document.getElementById('c_giaoVienId').value = specialists[0].id;
            }
        });
}

document.getElementById('createForm').addEventListener('submit', function (e) {
    e.preventDefault();
    const formData = new URLSearchParams();
    formData.append('hocKyId', document.getElementById('c_hocKyId').value);
    formData.append('lopHocId', document.getElementById('c_lopHocId').value);
    formData.append('monHocId', document.getElementById('c_monHocId').value);
    formData.append('giaoVienId', document.getElementById('c_giaoVienId').value);
    formData.append('soTietTuan', document.getElementById('c_soTietTuan').value);
    if (document.getElementById('c_tuNgay').value) formData.append('tuNgay', document.getElementById('c_tuNgay').value);
    if (document.getElementById('c_denNgay').value) formData.append('denNgay', document.getElementById('c_denNgay').value);

    fetch('/Admin/PhanCong/Create', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': getToken()
        },
        body: formData.toString()
    })
    .then(r => r.json())
    .then(res => {
        showToast(res.message, !res.success);
        if (res.success) {
            createModal.hide();
            setTimeout(() => location.reload(), 450);
        }
    })
    .catch(() => showToast('Lỗi kết nối máy chủ!', true));
});

function openEditModal(id) {
    fetch(`/Admin/PhanCong/GetById/${id}`)
        .then(r => r.json())
        .then(res => {
            if (!res.success) {
                showToast(res.message, true);
                return;
            }
            const d = res.data;
            document.getElementById('e_id').value = d.id;
            document.getElementById('e_tenLop').textContent = d.tenLop;
            document.getElementById('e_tenMon').textContent = d.tenMon;
            rebuildTeacherDropdown('e_giaoVienId', d.monHocId, d.giaoVienId || '');
            document.getElementById('e_soTietTuan').value = d.soTietTuan;
            document.getElementById('e_tuNgay').value = d.tuNgay;
            document.getElementById('e_denNgay').value = d.denNgay;
            editModal.show();
        });
}

document.getElementById('editForm').addEventListener('submit', function (e) {
    e.preventDefault();
    const formData = new URLSearchParams();
    formData.append('id', document.getElementById('e_id').value);
    formData.append('giaoVienId', document.getElementById('e_giaoVienId').value);
    formData.append('soTietTuan', document.getElementById('e_soTietTuan').value);
    if (document.getElementById('e_tuNgay').value) formData.append('tuNgay', document.getElementById('e_tuNgay').value);
    if (document.getElementById('e_denNgay').value) formData.append('denNgay', document.getElementById('e_denNgay').value);

    fetch('/Admin/PhanCong/Edit', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': getToken()
        },
        body: formData.toString()
    })
    .then(r => r.json())
    .then(res => {
        showToast(res.message, !res.success);
        if (res.success) {
            editModal.hide();
            setTimeout(() => location.reload(), 450);
        }
    })
    .catch(() => showToast('Lỗi kết nối máy chủ!', true));
});

function deletePhanCong(id, label) {
    if (!confirm(`Bạn có chắc muốn xóa phân công "${label}"?`)) return;

    const formData = new URLSearchParams();
    formData.append('id', id);

    fetch('/Admin/PhanCong/Delete', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': getToken()
        },
        body: formData.toString()
    })
    .then(r => r.json())
    .then(res => {
        showToast(res.message, !res.success);
        if (res.success) {
            setTimeout(() => location.reload(), 450);
        }
    })
    .catch(() => showToast('Lỗi kết nối máy chủ!', true));
}
</script>
}
