@model IEnumerable<QLHS.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản lý Tài Khoản";
}

<!-- TIÊU ĐỀ & NÚT THÊM MỚI -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-primary mb-1"><i class="bi bi-shield-lock me-2"></i>QUẢN LÝ TÀI KHOẢN</h3>
        <p class="text-muted mb-0">Danh sách tài khoản và phân quyền truy cập hệ thống.</p>
    </div>
    <button type="button" class="btn btn-primary fw-bold" onclick="openCreateModal()">
        <i class="bi bi-plus-circle me-1"></i>Thêm Tài Khoản
    </button>
</div>

<!-- BẢNG DANH SÁCH TÀI KHOẢN -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Tên Đăng Nhập</th>
                        <th>Email</th>
                        <th>Số Điện Thoại</th>
                        <th>Vai Trò</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Tạo</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 text-muted">#@item.Id</td>
                                <td class="fw-bold text-dark">@item.TenDangNhap</td>
                                <td>@(item.Email ?? "---")</td>
                                <td>@(item.SoDienThoai ?? "---")</td>
                                <td>
                                    @switch (item.VaiTro)
                                    {
                                        case "admin":
                                            <span class="badge bg-danger"><i class="bi bi-shield-fill-check me-1"></i>Admin</span>
                                            break;
                                        case "giao_vien":
                                            <span class="badge bg-success"><i class="bi bi-person-badge me-1"></i>Giáo viên</span>
                                            break;
                                        default:
                                            <span class="badge bg-info text-dark"><i class="bi bi-person me-1"></i>Phụ huynh</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (item.TrangThai == "hoat_dong")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Bị khóa</span>
                                    }
                                </td>
                                <td>@(item.NgayTao.HasValue ? item.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "---")</td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(@item.Id)" title="Sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="openDeleteModal(@item.Id, '@item.TenDangNhap')" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Chưa có tài khoản nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 1. MODAL THÊM TÀI KHOẢN -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus me-2"></i>Thêm Tài Khoản Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="createForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên đăng nhập <span class="text-danger">*</span></label>
                        <input type="text" name="TenDangNhap" class="form-control" required placeholder="Nhập tên đăng nhập..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu <span class="text-danger">*</span></label>
                        <input type="password" name="MatKhauHash" class="form-control" required placeholder="Nhập mật khẩu..." />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" name="Email" class="form-control" placeholder="example@email.com" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Số điện thoại</label>
                            <input type="text" name="SoDienThoai" class="form-control" placeholder="09xxxx..." />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Vai trò</label>
                            <select name="VaiTro" class="form-select">
                                <option value="admin">Admin</option>
                                <option value="giao_vien">Giáo viên</option>
                                <option value="phu_huynh" selected>Phụ huynh</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Trạng thái</label>
                            <select name="TrangThai" class="form-select">
                                <option value="hoat_dong" selected>Hoạt động</option>
                                <option value="bi_khoa">Bị khóa</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-bold">Lưu Tài Khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 2. MODAL SỬA TÀI KHOẢN -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Cập Nhật Tài Khoản</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="edit_id" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên đăng nhập</label>
                        <input type="text" id="edit_TenDangNhap" class="form-control bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu mới</label>
                        <input type="password" name="MatKhauMoi" class="form-control" placeholder="Bỏ trống nếu không muốn đổi mật khẩu" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" id="edit_Email" name="Email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Số điện thoại</label>
                            <input type="text" id="edit_SoDienThoai" name="SoDienThoai" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Vai trò</label>
                            <select id="edit_VaiTro" name="VaiTro" class="form-select">
                                <option value="admin">Admin</option>
                                <option value="giao_vien">Giáo viên</option>
                                <option value="phu_huynh">Phụ huynh</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Trạng thái</label>
                            <select id="edit_TrangThai" name="TrangThai" class="form-select">
                                <option value="hoat_dong">Hoạt động</option>
                                <option value="bi_khoa">Bị khóa</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning fw-bold">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 3. MODAL XÁC NHẬN XÓA -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Xác Nhận Xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="deleteForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="delete_id" name="id" />
                <div class="modal-body text-center py-4">
                    <p class="mb-1">Bạn có chắc chắn muốn xóa tài khoản:</p>
                    <h5 id="delete_TenDangNhap" class="text-danger fw-bold"></h5>
                    <small class="text-muted">Hành động này không thể hoàn tác!</small>
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger fw-bold">Đồng Ý Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JAVASCRIPT XỬ LÝ AJAX -->
@section Scripts {
    <script>
        const createModal = new bootstrap.Modal(document.getElementById('createModal'));
        const editModal = new bootstrap.Modal(document.getElementById('editModal'));
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        // 1. Mở Modal Thêm mới
        function openCreateModal() {
            document.getElementById('createForm').reset();
            createModal.show();
        }

        // 2. Mở Modal Sửa & Lấy dữ liệu AJAX
        function openEditModal(id) {
            fetch(`/Admin/TaiKhoan/GetById/${id}`)
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        document.getElementById('edit_id').value = res.data.id;
                        document.getElementById('edit_TenDangNhap').value = res.data.tenDangNhap;
                        document.getElementById('edit_Email').value = res.data.email || '';
                        document.getElementById('edit_SoDienThoai').value = res.data.soDienThoai || '';
                        document.getElementById('edit_VaiTro').value = res.data.vaiTro || 'phu_huynh';
                        document.getElementById('edit_TrangThai').value = res.data.trangThai || 'hoat_dong';
                        editModal.show();
                    } else {
                        alert(res.message);
                    }
                });
        }

        // 3. Mở Modal Xác nhận Xóa
        function openDeleteModal(id, tenDangNhap) {
            document.getElementById('delete_id').value = id;
            document.getElementById('delete_TenDangNhap').innerText = tenDangNhap;
            deleteModal.show();
        }

        // Gửi AJAX Form Thêm Mới
        document.getElementById('createForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(this);

            fetch('/Admin/TaiKhoan/Create', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        });

        // Gửi AJAX Form Sửa
        document.getElementById('editForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(this);

            fetch('/Admin/TaiKhoan/Edit', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        });

        // Gửi AJAX Form Xóa
        document.getElementById('deleteForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(this);

            fetch('/Admin/TaiKhoan/Delete', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        });
    </script>
}