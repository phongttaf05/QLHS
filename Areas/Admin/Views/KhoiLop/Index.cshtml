@model IEnumerable<QLHS.Models.KhoiLop>

@{
    ViewData["Title"] = "Quản lý Khối Lớp";
}

<!-- TIÊU ĐỀ & NÚT THÊM MỚI -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-primary mb-1"><i class="bi bi-layers me-2"></i>QUẢN LÝ KHỐI LỚP</h3>
        <p class="text-muted mb-0">Danh mục 5 khối lớp bậc Tiểu học (Khối 1 - Khối 5).</p>
    </div>
    <button type="button" class="btn btn-primary fw-bold" onclick="openCreateModal()">
        <i class="bi bi-plus-circle me-1"></i>Thêm Khối Lớp
    </button>
</div>

<!-- BẢNG DANH SÁCH KHỐI LỚP -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Tên Khối</th>
                        <th>Số Lượng Lớp Trực Thuộc</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 text-muted">#@item.Id</td>
                                <td>
                                    <span class="fw-bold text-primary fs-5">Khối @item.SoKhoi</span>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark border">
                                        <i class="bi bi-door-open me-1"></i>@(item.LopHocs != null ? item.LopHocs.Count : 0) lớp
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(@item.Id)" title="Sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="openDeleteModal(@item.Id, 'Khối @item.SoKhoi')" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Chưa có dữ liệu khối lớp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 1. MODAL THÊM KHỐI LỚP -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-square me-2"></i>Thêm Khối Lớp Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="createForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số khối <span class="text-danger">*</span></label>
                        <select id="create_SoKhoi" name="SoKhoi" class="form-select">
                            <option value="1">Khối 1</option>
                            <option value="2">Khối 2</option>
                            <option value="3">Khối 3</option>
                            <option value="4">Khối 4</option>
                            <option value="5">Khối 5</option>
                        </select>
                        <div class="text-danger small mt-1" id="create_error_SoKhoi"></div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-bold">Lưu Khối Lớp</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 2. MODAL SỬA KHỐI LỚP -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Cập Nhật Khối Lớp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="edit_id" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số khối <span class="text-danger">*</span></label>
                        <select id="edit_SoKhoi" name="SoKhoi" class="form-select">
                            <option value="1">Khối 1</option>
                            <option value="2">Khối 2</option>
                            <option value="3">Khối 3</option>
                            <option value="4">Khối 4</option>
                            <option value="5">Khối 5</option>
                        </select>
                        <div class="text-danger small mt-1" id="edit_error_SoKhoi"></div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning fw-bold">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 3. MODAL XÁC NHẬN XÓA -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Xác Nhận Xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="deleteForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="delete_id" name="id" />
                <div class="modal-body text-center py-4">
                    <p class="mb-1">Bạn có chắc chắn muốn xóa:</p>
                    <h5 id="delete_TenKhoi" class="text-danger fw-bold"></h5>
                    <small class="text-muted">Hành động này không thể hoàn tác!</small>
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger fw-bold">Đồng Ý Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JAVASCRIPT XỬ LÝ AJAX & RÀNG BUỘC CLIENT -->
@section Scripts {
    <script>
        const createModal = new bootstrap.Modal(document.getElementById('createModal'));
        const editModal = new bootstrap.Modal(document.getElementById('editModal'));
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        function openCreateModal() {
            document.getElementById('createForm').reset();
            document.getElementById('create_error_SoKhoi').innerText = '';
            createModal.show();
        }

        function openEditModal(id) {
            document.getElementById('edit_error_SoKhoi').innerText = '';
            fetch(`/Admin/KhoiLop/GetById/${id}`)
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        document.getElementById('edit_id').value = res.data.id;
                        document.getElementById('edit_SoKhoi').value = res.data.soKhoi;
                        editModal.show();
                    } else {
                        alert(res.message);
                    }
                });
        }

        function openDeleteModal(id, tenKhoi) {
            document.getElementById('delete_id').value = id;
            document.getElementById('delete_TenKhoi').innerText = tenKhoi;
            deleteModal.show();
        }

        // Submit Form Thêm Mới
        document.getElementById('createForm').addEventListener('submit', function (e) {
            e.preventDefault();
            document.getElementById('create_error_SoKhoi').innerText = '';

            fetch('/Admin/KhoiLop/Create', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    document.getElementById('create_error_SoKhoi').innerText = res.message;
                }
            });
        });

        // Submit Form Sửa
        document.getElementById('editForm').addEventListener('submit', function (e) {
            e.preventDefault();
            document.getElementById('edit_error_SoKhoi').innerText = '';

            fetch('/Admin/KhoiLop/Edit', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    document.getElementById('edit_error_SoKhoi').innerText = res.message;
                }
            });
        });

        // Submit Form Xóa
        document.getElementById('deleteForm').addEventListener('submit', function (e) {
            e.preventDefault();
            fetch('/Admin/KhoiLop/Delete', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message); // Hiển thị thông báo ràng buộc nếu đã có Lớp học hoặc Cấu hình môn
                }
            });
        });
    </script>
}