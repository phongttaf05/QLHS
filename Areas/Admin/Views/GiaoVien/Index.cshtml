@model IEnumerable<QLHS.Models.GiaoVien>

@{
    ViewData["Title"] = "Quản lý Hồ sơ Giáo viên";
    var monHocs = ViewBag.MonHocs as List<QLHS.Models.MonHoc>;
}

<!-- TIÊU ĐỀ & NÚT THÊM MỚI -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-primary mb-1"><i class="bi bi-person-badge me-2"></i>QUẢN LÝ HỒ SƠ GIÁO VIÊN</h3>
        <p class="text-muted mb-0">Quản lý lý lịch giáo viên, tài khoản đăng nhập và chức năng Reset mật khẩu.</p>
    </div>
    <button type="button" class="btn btn-primary fw-bold" onclick="openCreateModal()">
        <i class="bi bi-person-plus-fill me-1"></i>Thêm Giáo Viên Mới
    </button>
</div>

<!-- TÌM KIẾM -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tìm kiếm theo Họ tên, CCCD, Tên đăng nhập, SĐT..." value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold"><i class="bi bi-funnel me-1"></i>Tìm kiếm</button>
                <a href="/Admin/GiaoVien" class="btn btn-outline-secondary" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG GIÁO VIÊN -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 60px;">STT</th>
                        <th>Họ Và Tên</th>
                        <th>Số CCCD</th>
                        <th>Tên Đăng Nhập</th>
                        <th>Mật Khẩu</th>
                        <th>Thông Tin Liên Hệ</th>
                        <th>Chuyên Môn</th>
                        <th>Lớp Chủ Nhiệm</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            var lopChuNhiem = item.LopHocs?.FirstOrDefault();
                            var tk = item.TaiKhoan;
                            <tr>
                                <td class="ps-3 text-muted fw-bold">@(stt++)</td>
                                <td class="fw-bold text-dark fs-6">@item.HoTen</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Cccd))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace"><i class="bi bi-card-heading me-1 text-primary"></i>@item.Cccd</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <td>
                                    @if (tk != null)
                                    {
                                        <strong class="text-primary"><i class="bi bi-person-check me-1"></i>@tk.TenDangNhap</strong>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Chưa có tài khoản</span>
                                    }
                                </td>
                                <td>
                                    <!-- MẬT KHẨU ĐƯỢC CHE KÍN -->
                                    <span class="text-muted font-monospace me-2">••••••••</span>
                                    @if (tk != null)
                                    {
                                        <button class="btn btn-xs btn-outline-danger py-0 px-2 rounded-pill" onclick="openResetModal(@item.Id, '@item.HoTen', '@tk.TenDangNhap')" title="Reset mật khẩu về 123456">
                                            <i class="bi bi-key-fill me-1"></i>Reset
                                        </button>
                                    }
                                </td>
                                <td>
                                    @if (tk != null)
                                    {
                                        <div class="small">
                                            <div><i class="bi bi-telephone me-1 text-success"></i>@(string.IsNullOrEmpty(tk.SoDienThoai) ? "---" : tk.SoDienThoai)</div>
                                            <div class="text-muted"><i class="bi bi-envelope me-1 text-secondary"></i>@(string.IsNullOrEmpty(tk.Email) ? "---" : tk.Email)</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <td>
                                    @if (item.GiaoVienMonHocs != null && item.GiaoVienMonHocs.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1" style="max-width: 220px;">
                                            @foreach (var gm in item.GiaoVienMonHocs.OrderBy(x => x.MonHoc?.TenMon))
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info">@gm.MonHoc?.TenMon</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa gán</span>
                                    }
                                </td>
                                <td>
                                    @if (lopChuNhiem != null)
                                    {
                                        <span class="fw-bold text-success"><i class="bi bi-door-open me-1"></i>Lớp @lopChuNhiem.TenLop</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(@item.Id)" title="Sửa thông tin">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="openDeleteModal(@item.Id, '@item.HoTen')" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Chưa có thông tin giáo viên nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 1. MODAL THÊM GIÁO VIÊN & CẤP TÀI KHOẢN MỚI -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Thêm Giáo Viên & Cấp Tài Khoản Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="createForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <h6 class="fw-bold text-primary mb-3"><i class="bi bi-person-vcard me-2"></i>I. THÔNG TIN CÁ NHÂN GIÁO VIÊN</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Họ và tên giáo viên <span class="text-danger">*</span></label>
                            <input type="text" id="create_HoTen" name="HoTen" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Số Căn cước công dân (CCCD)</label>
                            <input type="text" id="create_Cccd" name="Cccd" class="form-control" placeholder="Nhập 12 số CCCD..." />
                        </div>
                    </div>

                    <hr class="my-3 opacity-25" />

                    <h6 class="fw-bold text-success mb-3"><i class="bi bi-shield-lock me-2"></i>II. ĐĂNG KÝ TÀI KHOẢN ĐĂNG NHẬP</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tên đăng nhập <span class="text-danger">*</span></label>
                            <input type="text" id="create_TenDangNhap" name="TenDangNhap" class="form-control" placeholder="Ví dụ: gv_nguyenvana" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Mật khẩu mặc định</label>
                            <input type="text" class="form-control bg-light fw-bold text-danger" value="123456" readonly />
                            <small class="text-muted d-block mt-1">Tài khoản mới sẽ có mật khẩu mặc định là <strong>123456</strong>.</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Số điện thoại</label>
                            <input type="text" name="SoDienThoai" class="form-control" placeholder="09xxxxxxxx" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Email liên hệ</label>
                            <input type="email" name="Email" class="form-control" placeholder="giaovien@school.edu.vn" />
                        </div>
                    </div>

                    <hr class="my-3 opacity-25" />

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-info mb-0"><i class="bi bi-book me-2"></i>III. CHUYÊN MÔN GIẢNG DẠY</h6>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary py-0" onclick="toggleAllSubjects('create', true)">Chọn tất cả</button>
                            <button type="button" class="btn btn-outline-secondary py-0" onclick="toggleAllSubjects('create', false)">Bỏ chọn</button>
                        </div>
                    </div>
                    <div class="row g-2 p-2 bg-light rounded border">
                        @if (monHocs != null)
                        {
                            foreach (var m in monHocs)
                            {
                                <div class="col-6 col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input create-mon-chk" type="checkbox" name="MonHocIds" value="@m.Id" id="c_mon_@m.Id">
                                        <label class="form-check-label small fw-semibold" for="c_mon_@m.Id">@m.TenMon</label>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-bold">Tạo Giáo Viên & Tài Khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 2. MODAL CẬP NHẬT HỒ SƠ (KHÔNG SỬA MẬT KHẨU TẠI ĐÂY) -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Cập Nhật Hồ Sơ & Tài Khoản</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="edit_id" name="id" />
                <div class="modal-body p-4">
                    <h6 class="fw-bold text-primary mb-3"><i class="bi bi-person-vcard me-2"></i>I. THÔNG TIN CÁ NHÂN GIÁO VIÊN</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Họ và tên giáo viên <span class="text-danger">*</span></label>
                            <input type="text" id="edit_HoTen" name="HoTen" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Số Căn cước công dân (CCCD)</label>
                            <input type="text" id="edit_Cccd" name="Cccd" class="form-control" />
                        </div>
                    </div>

                    <hr class="my-3 opacity-25" />

                    <h6 class="fw-bold text-success mb-3"><i class="bi bi-shield-lock me-2"></i>II. THÔNG TIN TÀI KHOẢN</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tên đăng nhập <span class="text-danger">*</span></label>
                            <input type="text" id="edit_TenDangNhap" name="TenDangNhap" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Số điện thoại</label>
                            <input type="text" id="edit_SoDienThoai" name="SoDienThoai" class="form-control" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Email liên hệ</label>
                            <input type="email" id="edit_Email" name="Email" class="form-control" />
                        </div>
                    </div>

                    <hr class="my-3 opacity-25" />

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-info mb-0"><i class="bi bi-book me-2"></i>III. CHUYÊN MÔN GIẢNG DẠY</h6>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary py-0" onclick="toggleAllSubjects('edit', true)">Chọn tất cả</button>
                            <button type="button" class="btn btn-outline-secondary py-0" onclick="toggleAllSubjects('edit', false)">Bỏ chọn</button>
                        </div>
                    </div>
                    <div class="row g-2 p-2 bg-light rounded border">
                        @if (monHocs != null)
                        {
                            foreach (var m in monHocs)
                            {
                                <div class="col-6 col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input edit-mon-chk" type="checkbox" name="MonHocIds" value="@m.Id" id="e_mon_@m.Id">
                                        <label class="form-check-label small fw-semibold" for="e_mon_@m.Id">@m.TenMon</label>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning fw-bold">Cập Nhật Hồ Sơ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 3. MODAL XÁC NHẬN RESET MẬT KHẨU VỀ 123456 -->
<div class="modal fade" id="resetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="bi bi-key-fill me-2"></i>Reset Mật Khẩu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="resetForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="reset_id" name="id" />
                <div class="modal-body text-center py-4">
                    <p class="mb-1">Đặt lại mật khẩu cho giáo viên:</p>
                    <h5 id="reset_HoTen" class="text-primary fw-bold mb-1"></h5>
                    <small class="text-muted d-block mb-3">Tài khoản: <strong id="reset_TenDangNhap"></strong></small>
                    <div class="alert alert-warning py-2 small mb-0">
                        Mật khẩu mới sẽ là: <strong class="text-danger fs-6">123456</strong>
                    </div>
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning fw-bold text-dark">Xác Nhận Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 4. MODAL XÁC NHẬN XÓA -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Xác Nhận Xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="deleteForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="delete_id" name="id" />
                <div class="modal-body text-center py-4">
                    <p class="mb-1">Bạn có chắc muốn xóa giáo viên:</p>
                    <h5 id="delete_HoTen" class="text-danger fw-bold"></h5>
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger fw-bold">Đồng Ý Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const createModal = new bootstrap.Modal(document.getElementById('createModal'));
        const editModal = new bootstrap.Modal(document.getElementById('editModal'));
        const resetModal = new bootstrap.Modal(document.getElementById('resetModal'));
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        function toggleAllSubjects(prefix, checked) {
            document.querySelectorAll(`.${prefix}-mon-chk`).forEach(chk => chk.checked = checked);
        }

        function openCreateModal() {
            document.getElementById('createForm').reset();
            toggleAllSubjects('create', false);
            createModal.show();
        }

        function openEditModal(id) {
            fetch(`/Admin/GiaoVien/GetById/${id}`)
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        document.getElementById('edit_id').value = res.data.id;
                        document.getElementById('edit_HoTen').value = res.data.hoTen;
                        document.getElementById('edit_Cccd').value = res.data.cccd || '';
                        document.getElementById('edit_TenDangNhap').value = res.data.tenDangNhap || '';
                        document.getElementById('edit_SoDienThoai').value = res.data.soDienThoai || '';
                        document.getElementById('edit_Email').value = res.data.email || '';

                        const selectedIds = res.data.monHocIds || [];
                        document.querySelectorAll('.edit-mon-chk').forEach(chk => {
                            chk.checked = selectedIds.includes(parseInt(chk.value));
                        });

                        editModal.show();
                    } else {
                        alert(res.message);
                    }
                });
        }

        function openResetModal(id, hoTen, tenDangNhap) {
            document.getElementById('reset_id').value = id;
            document.getElementById('reset_HoTen').innerText = hoTen;
            document.getElementById('reset_TenDangNhap').innerText = tenDangNhap;
            resetModal.show();
        }

        function openDeleteModal(id, hoTen) {
            document.getElementById('delete_id').value = id;
            document.getElementById('delete_HoTen').innerText = hoTen;
            deleteModal.show();
        }

        // Submit Form Thêm Mới
        document.getElementById('createForm').addEventListener('submit', function (e) {
            e.preventDefault();
            fetch('/Admin/GiaoVien/Create', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        });

        // Submit Form Cập Nhật Hồ Sơ
        document.getElementById('editForm').addEventListener('submit', function (e) {
            e.preventDefault();
            fetch('/Admin/GiaoVien/Edit', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        });

        // Submit Form Reset Mật Khẩu
        document.getElementById('resetForm').addEventListener('submit', function (e) {
            e.preventDefault();
            fetch('/Admin/GiaoVien/ResetPassword', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    resetModal.hide();
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        });

        // Submit Form Xóa
        document.getElementById('deleteForm').addEventListener('submit', function (e) {
            e.preventDefault();
            fetch('/Admin/GiaoVien/Delete', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        });
    </script>
}