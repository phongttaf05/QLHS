}

function triggerPreCheck() {
    let config = null;
    if (document.getElementById('modalConfigDotXep').classList.contains('show')) {
        config = collectConfigFromUI();
    }

    fetch('/Admin/ThoiKhoaBieu/ValidatePreCheck', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': getAntiForgeryToken()
        },
        body: JSON.stringify({
            banTkbId: currentBanTkbId,
            config: config
        })
    })
    .then(res => res.json())
    .then(data => {
        const content = document.getElementById('preCheckReportContent');
        let html = '';

        if (data.isValid) {
            html += `<div class="alert alert-success d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                <div>
                    <h6 class="mb-0 fw-bold">TẤT CẢ ĐIỀU KIỆN ĐÃ HỢP LỆ!</h6>
                    <small>Đã kiểm tra ${data.tongSoLopChon} lớp học và ${data.tongSoGiaoVienChon} giáo viên. Chào cờ & Sinh hoạt lớp hợp lệ. Sẵn sàng chốt đầu vào!</small>
                </div>
            </div>`;
        } else {
            html += `<div class="alert alert-danger d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                <div>
                    <h6 class="mb-0 fw-bold">PHÁT HIỆN LỖI CHẶN (${data.errors.length} lỗi):</h6>
                    <small>Cần điều chỉnh trước khi có thể chốt đầu vào.</small>
                </div>
            </div>`;

            html += `<div class="list-group mb-3">`;
            data.errors.forEach(err => {
                html += `<div class="list-group-item list-group-item-danger small fw-semibold"><i class="bi bi-x-circle me-2"></i>${err}</div>`;
            });
            html += `</div>`;
        }

        if (data.warnings && data.warnings.length > 0) {
            html += `<h6 class="fw-bold text-warning mt-3"><i class="bi bi-exclamation-circle me-1"></i>Cảnh Báo Chuyên Môn (${data.warnings.length}):</h6>`;
            html += `<div class="list-group mb-3">`;
            data.warnings.forEach(w => {
                html += `<div class="list-group-item list-group-item-warning small"><i class="bi bi-info-circle me-2"></i>${w}</div>`;
            });
            html += `</div>`;
        }

        content.innerHTML = html;
        document.getElementById('btnChotNgayTrongModal').style.display = data.isValid ? '' : 'none';
        new bootstrap.Modal(document.getElementById('modalPreCheckReport')).show();
    });
}

