    if (!confirm(msg)) return;

    const formData = new URLSearchParams();
    formData.append('banTkbId', banTkbId);
    if (giaoVienId) formData.append('giaoVienId', giaoVienId);

    fetch('/Admin/ThoiKhoaBieu/AdminXacNhanThay', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': getAntiForgeryToken()
        },
        body: formData.toString()
    })
    .then(r => r.json())
    .then(data => {
        alert(data.message);
        if (data.success) location.reload();
    });
}

// Drag & drop handlers (hoạt động thật ở chế độ xem theo Lớp khi LICH_NHAP / CHO_GV_XAC_NHAN)
const khungTietMap = @Html.Raw(ViewBag.KhungTietMapJson ?? "{}");
let draggedSlot = null;

function onDragStartSlot(ev, fromKhungTietId, monHocId, giaoVienId, phanCongId) {
    draggedSlot = { fromKhungTietId, monHocId, giaoVienId, phanCongId };
    ev.dataTransfer.effectAllowed = 'move';
}

function onDragOver(ev) {
    if (draggedSlot) {
        ev.preventDefault();
        ev.dataTransfer.dropEffect = 'move';
    }
}

function sendMoveSlot(toKhungTietId) {
    if (!draggedSlot || !toKhungTietId || draggedSlot.fromKhungTietId === toKhungTietId) return;

    const payload = {
        banTkbId: @selectedBanTkbId,
        lopHocId: @selectedLopId,
        fromKhungTietId: draggedSlot.fromKhungTietId,
        toKhungTietId: toKhungTietId,
        monHocId: draggedSlot.monHocId,
        giaoVienId: draggedSlot.giaoVienId,
        phanCongId: draggedSlot.phanCongId
    };
    draggedSlot = null;

    fetch('/Admin/ThoiKhoaBieu/UpdateDraftSlot', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': getAntiForgeryToken()
        },
        body: JSON.stringify(payload)
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert(data.message);
        }
    });
}

function onDropSlot(ev, targetSlotId) {
    ev.preventDefault();
    sendMoveSlot(targetSlotId);
}

function onDropEmpty(ev, thu, tiet, buoi) {
    ev.preventDefault();
    const key = `${thu}_${buoi.toUpperCase()}_${tiet}`;
    const targetSlotId = khungTietMap[key];
    if (targetSlotId) {
        sendMoveSlot(targetSlotId);
    } else {
        alert('Không tìm thấy khung tiết đích!');
    }
}
