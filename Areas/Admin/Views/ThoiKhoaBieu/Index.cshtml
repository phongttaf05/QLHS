<script>
let currentBanTkbId = @selectedBanTkbId;
let serverData = null;

function getAntiForgeryToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
}

function showModalTaoBanTkb() {
    new bootstrap.Modal(document.getElementById('modalTaoBanTkb')).show();
}

function submitTaoBanTkb() {
    const hocKyId = document.getElementById('newHocKyId').value;
    const tuNgay = document.getElementById('newTuNgay').value;
    const denNgay = document.getElementById('newDenNgay').value;

    fetch('/Admin/ThoiKhoaBieu/CreateBanTkb', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': getAntiForgeryToken()
        },
        body: `hocKyId=${hocKyId}&tuNgay=${tuNgay}&denNgay=${denNgay}`
    })
    .then(res => res.json())
    .then(data => {
        alert(data.message);
        if (data.success) location.href = '/Admin/ThoiKhoaBieu?banTkbId=' + data.banTkbId;
    });
}

function openConfigModal() {
    if (!currentBanTkbId) return;

    fetch('/Admin/ThoiKhoaBieu/GetConfigData?banTkbId=' + currentBanTkbId)
        .then(res => res.json())
        .then(res => {
            if (!res.success) {
                alert(res.message);
                return;
            }
            serverData = res;
            renderConfigTabs();
            new bootstrap.Modal(document.getElementById('modalConfigDotXep')).show();
        });
}

function renderConfigTabs() {
    if (!serverData) return;

    const saved = serverData.currentConfig || {};
    const savedLopIds = saved.lop_ids || serverData.danhSachLop.map(l => l.id);
    const savedGvIds = saved.giao_vien_ids || serverData.danhSachGiaoVien.map(g => g.id);

    // 1. Render Danh sách lớp
    const lopContainer = document.getElementById('lopListContainer');
    lopContainer.innerHTML = '';
    serverData.danhSachLop.forEach(lop => {
        const isChecked = savedLopIds.includes(lop.id) ? 'checked' : '';
        const col = document.createElement('div');
        col.className = 'col-md-3 col-sm-6 lop-item';
        col.setAttribute('data-khoi-id', lop.khoiId);
        col.innerHTML = `
            <div class="card border p-2 h-100 shadow-sm">
                <div class="form-check">
                    <input class="form-check-input lop-checkbox" type="checkbox" value="${lop.id}" id="chk_lop_${lop.id}" ${isChecked} onchange="onLopSelectionChanged()">
                    <label class="form-check-label fw-bold text-dark" for="chk_lop_${lop.id}">
                        Lớp ${lop.tenLop} <span class="badge bg-light text-primary border ms-1">Khối ${lop.soKhoi}</span>
                        <div class="small text-muted fw-normal">GVCN: ${lop.tenGvcn}</div>
                    </label>
                </div>
            </div>
        `;
        lopContainer.appendChild(col);
    });

    // 2. Render Tab Lớp - Môn
    renderLopMonTab(saved.lop_mon_settings);

    // 3. Render Tab Giáo Viên
    renderGiaoVienTab(savedGvIds);

    // 4. Render Tab Buổi học
    renderBuoiHocTab(saved.buoi_hocs);

    // Checkbox HĐTN
    document.getElementById('chkChaoCoVaoHdtn').checked = saved.tinh_chao_co_vao_hdtn !== false;
    document.getElementById('chkSinhHoatVaoHdtn').checked = saved.tinh_sinh_hoat_vao_hdtn !== false;
}

function filterLopByKhoi() {
    const val = document.getElementById('filterKhoiSelect').value;
    document.querySelectorAll('.lop-item').forEach(el => {
        if (val === 'ALL' || el.getAttribute('data-khoi-id') === val) {
            el.style.display = '';
        } else {
            el.style.display = 'none';
        }
    });
}

function selectAllLop(check) {
    document.querySelectorAll('.lop-checkbox').forEach(chk => {
        if (chk.closest('.lop-item').style.display !== 'none') {
            chk.checked = check;
        }
    });
    onLopSelectionChanged();
}

function onLopSelectionChanged() {
    renderGiaoVienTab();
    renderLopMonTab();
}

function renderLopMonTab(savedSettings) {
    const targetLopIds = getSelectedLopIds();
    const tbody = document.getElementById('lopMonTableBody');
    tbody.innerHTML = '';

    const currentSaved = savedSettings || [];

    serverData.danhSachLop.filter(l => targetLopIds.includes(l.id)).forEach(lop => {
        const pcs = serverData.phanCongs.filter(p => p.lopId === lop.id);

        pcs.forEach(pc => {
            const setting = currentSaved.find(s => s.lop_hoc_id === lop.id && s.mon_hoc_id === pc.monId);
            const soChuan = setting ? setting.so_tiet_chuan : pc.soTietTuan;
            const soXep = setting ? setting.so_tiet_tuan : soChuan;
            const minN = setting ? setting.min_tiet_ngay : 0;
            const maxN = setting ? setting.max_tiet_ngay : 2;
            const minT = setting ? setting.min_tiet_tuan : 0;
            const maxT = setting ? setting.max_tiet_tuan : 10;
            const linhHoat = setting ? setting.che_do_linh_hoat : false;

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="fw-bold">${pc.tenLop}</td>
                <td class="text-primary fw-semibold">${pc.tenMon}</td>
                <td><span class="badge bg-secondary">${soChuan}</span></td>
                <td>
                    <input type="number" class="form-control form-control-sm text-center lop-mon-tiet" data-lop-id="${lop.id}" data-mon-id="${pc.monId}" data-gv-id="${pc.giaoVienId}" value="${soXep}" min="1" max="15" ${!linhHoat ? 'readonly' : ''}>
                </td>
                <td>
                    <div class="input-group input-group-sm">
                        <input type="number" class="form-control text-center p-1 lop-mon-min-ngay" value="${minN}" min="0" max="4" title="Tối thiểu/ngày">
                        <span class="input-group-text p-1">-</span>
                        <input type="number" class="form-control text-center p-1 lop-mon-max-ngay" value="${maxN}" min="1" max="4" title="Tối đa/ngày">
                    </div>
                </td>
                <td>
                    <div class="input-group input-group-sm">
                        <input type="number" class="form-control text-center p-1 lop-mon-min-tuan" value="${minT}" min="0" max="15" title="Min tuần">
                        <span class="input-group-text p-1">-</span>
                        <input type="number" class="form-control text-center p-1 lop-mon-max-tuan" value="${maxT}" min="1" max="15" title="Max tuần">
                    </div>
                </td>
                <td class="text-center">
                    <input type="checkbox" class="form-check-input lop-mon-linh-hoat" ${linhHoat ? 'checked' : ''} onchange="toggleLinhHoat(this)">
                </td>
                <td><span class="fw-semibold text-dark">${pc.tenGiaoVien}</span></td>
                <td>
                    ${pc.trangThaiXacNhan === 'DA_XAC_NHAN' 
                        ? '<span class="badge bg-success">Đã xác nhận</span>' 
                        : (pc.trangThaiXacNhan === 'CAN_DIEU_CHINH' ? `<span class="badge bg-danger" title="${pc.yKien}">Cần điều chỉnh</span>` : '<span class="badge bg-warning text-dark">Chờ xác nhận</span>')}
                </td>
            `;
            tbody.appendChild(tr);
        });
    });
}

function toggleLinhHoat(chk) {
    const row = chk.closest('tr');
    const inputTiet = row.querySelector('.lop-mon-tiet');
    inputTiet.readOnly = !chk.checked;
    if (!chk.checked) {
        // Khôi phục về số chuẩn
        const soChuan = parseInt(row.cells[2].innerText);
        inputTiet.value = soChuan;
    }
}

function renderGiaoVienTab(selectedGvIds) {
    const targetLopIds = getSelectedLopIds();
    const gvTbody = document.getElementById('gvTableBody');
    gvTbody.innerHTML = '';

    const currentCheckedGv = selectedGvIds || Array.from(document.querySelectorAll('.gv-checkbox:checked')).map(c => parseInt(c.value));

    serverData.danhSachGiaoVien.forEach(gv => {
        const pcs = serverData.phanCongs.filter(p => p.giaoVienId === gv.id && targetLopIds.includes(p.lopId));
        const gbs = serverData.gioBans.filter(g => g.giaoVienId === gv.id);

        const isChecked = currentCheckedGv.includes(gv.id) ? 'checked' : '';
        const pcText = pcs.length > 0 
            ? pcs.map(p => `<span class="badge bg-light text-dark border me-1">${p.tenLop}: ${p.tenMon} (${p.soTietTuan}t)</span>`).join('') 
            : '<span class="text-muted small">Không có phân công trong lớp đã chọn</span>';

        let xnBadge = '<span class="badge bg-secondary">Không có</span>';
        if (pcs.length > 0) {
            const hasCanChinh = pcs.some(p => p.trangThaiXacNhan === 'CAN_DIEU_CHINH');
            const allDaXn = pcs.every(p => p.trangThaiXacNhan === 'DA_XAC_NHAN');
            if (hasCanChinh) {
                xnBadge = '<span class="badge bg-danger">Yêu cầu chỉnh</span>';
            } else if (allDaXn) {
                xnBadge = '<span class="badge bg-success">Đã xác nhận đủ</span>';
            } else {
                xnBadge = '<span class="badge bg-warning text-dark">Chờ xác nhận</span>';
            }
        }

        const gbText = gbs.length > 0
            ? gbs.map(g => `<span class="badge ${g.batBuoc ? 'bg-danger' : 'bg-warning text-dark'} me-1" title="${g.ghiChu}">T${g.thu} ${g.buoi} t${g.tiet}${g.batBuoc ? ' (Bắt buộc)' : ' (Tránh)'}</span>`).join('')
            : '<span class="text-muted small">Trống</span>';

        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="text-center">
                <input type="checkbox" class="gv-checkbox" value="${gv.id}" ${isChecked} />
            </td>
            <td class="fw-bold">${gv.hoTen}</td>
            <td>${pcText}</td>
            <td>${xnBadge}</td>
            <td>${gbText}</td>
        `;
        gvTbody.appendChild(tr);
    });
}

function toggleSelectAllGv(check) {
