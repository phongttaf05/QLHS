}

function renderBuoiHocTab(savedBuoiHocs) {
    const tbody = document.getElementById('buoiHocTableBody');
    tbody.innerHTML = '';

    const days = [
        { thu: 2, tenThu: 'Thứ 2' },
        { thu: 3, tenThu: 'Thứ 3' },
        { thu: 4, tenThu: 'Thứ 4' },
        { thu: 5, tenThu: 'Thứ 5' },
        { thu: 6, tenThu: 'Thứ 6' }
    ];

    days.forEach(d => {
        ['SANG', 'CHIEU'].forEach(buoi => {
            const isSavedCoHoc = savedBuoiHocs 
                ? savedBuoiHocs.some(b => b.thu === d.thu && b.buoi.toUpperCase() === buoi && b.co_hoc) 
                : true;

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="fw-bold">${d.tenThu}</td>
                <td class="${buoi === 'SANG' ? 'text-primary' : 'text-warning'} fw-bold">${buoi}</td>
                <td>
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input buoi-co-hoc-chk" type="checkbox" data-thu="${d.thu}" data-buoi="${buoi}" ${isSavedCoHoc ? 'checked' : ''}>
                    </div>
                </td>
                <td class="small text-muted">${d.thu === 2 && buoi === 'SANG' ? 'Có tiết Chào cờ (Tiết 1)' : (d.thu === 6 && buoi === 'CHIEU' ? 'Có tiết Sinh hoạt lớp (Tiết cuối)' : 'Tiết học thông thường')}</td>
            `;
            tbody.appendChild(tr);
        });
    });
}

function getSelectedLopIds() {
    return Array.from(document.querySelectorAll('.lop-checkbox:checked')).map(c => parseInt(c.value));
}

function collectConfigFromUI() {
    const lopIds = getSelectedLopIds();
    const gvIds = Array.from(document.querySelectorAll('.gv-checkbox:checked')).map(c => parseInt(c.value));

    const buoiHocs = [];
    document.querySelectorAll('.buoi-co-hoc-chk').forEach(chk => {
        buoiHocs.push({
            thu: parseInt(chk.getAttribute('data-thu')),
            buoi: chk.getAttribute('data-buoi'),
            co_hoc: chk.checked
        });
    });

    const lopMonSettings = [];
    document.querySelectorAll('.lop-mon-tiet').forEach(inp => {
        const lId = parseInt(inp.getAttribute('data-lop-id'));
        const mId = parseInt(inp.getAttribute('data-mon-id'));
        const gvId = parseInt(inp.getAttribute('data-gv-id'));
        const row = inp.closest('tr');
        const soChuan = parseInt(row.cells[2].innerText) || 0;
        const soXep = parseInt(inp.value) || 0;
        const minN = parseInt(row.querySelector('.lop-mon-min-ngay').value) || 0;
        const maxN = parseInt(row.querySelector('.lop-mon-max-ngay').value) || 2;
        const minT = parseInt(row.querySelector('.lop-mon-min-tuan').value) || 0;
        const maxT = parseInt(row.querySelector('.lop-mon-max-tuan').value) || 10;
        const linhHoat = row.querySelector('.lop-mon-linh-hoat').checked;

        lopMonSettings.push({
            lop_hoc_id: lId,
            mon_hoc_id: mId,
            giao_vien_id: gvId,
            so_tiet_chuan: soChuan,
            so_tiet_tuan: soXep,
            min_tiet_ngay: minN,
            max_tiet_ngay: maxN,
            min_tiet_tuan: minT,
            max_tiet_tuan: maxT,
            che_do_linh_hoat: linhHoat
        });
    });

    return {
        lop_ids: lopIds,
        giao_vien_ids: gvIds,
        buoi_hocs: buoiHocs,
        lop_mon_settings: lopMonSettings,
        tinh_chao_co_vao_hdtn: document.getElementById('chkChaoCoVaoHdtn').checked,
        tinh_sinh_hoat_vao_hdtn: document.getElementById('chkSinhHoatVaoHdtn').checked
    };
}

