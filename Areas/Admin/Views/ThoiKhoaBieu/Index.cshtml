@model IEnumerable<QLHS.Models.ThoiKhoaBieu>

@{
    ViewData["Title"] = "Cấu hình & Tự động xếp Thời khóa biểu";
    var dsHocKy = ViewBag.DanhSachHocKy as List<QLHS.Models.HocKy>;
    var dsBanTkb = ViewBag.DanhSachBanTkb as List<QLHS.Models.BanTkb>;
    var banTkbHienTai = ViewBag.BanTkbHienTai as QLHS.Models.BanTkb;
    var dsLop = ViewBag.DanhSachLop as List<QLHS.Models.LopHoc>;
    var allLopInNam = ViewBag.AllLopInNam as List<QLHS.Models.LopHoc>;
    var allGiaoVien = ViewBag.AllGiaoVien as List<QLHS.Models.GiaoVien>;
    var allKhoi = ViewBag.AllKhoi as List<QLHS.Models.KhoiLop>;
    var lopHocHienTai = ViewBag.LopHocHienTai as QLHS.Models.LopHoc;
    var giaoVienHienTai = ViewBag.GiaoVienHienTai as QLHS.Models.GiaoVien;
    int selectedBanTkbId = ViewBag.SelectedBanTkbId ?? 0;
    int selectedLopId = ViewBag.SelectedLopId ?? 0;
    int selectedGvId = ViewBag.SelectedGiaoVienId ?? 0;
    string viewType = ViewBag.ViewType as string ?? "class";

    QLHS.Models.ThoiKhoaBieu? GetSlot(int thu, int tiet, string buoi)
    {
        if (Model == null) return null;
        return Model.FirstOrDefault(t => 
            t.KhungTiet != null && 
            t.KhungTiet.ThuTrongTuan == thu && 
            t.KhungTiet.TietHoc == tiet && 
            t.KhungTiet.BuoiHoc != null && 
            t.KhungTiet.BuoiHoc.ToLower() == buoi.ToLower());
    }
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 d-print-none">
    <div>
        <h3 class="fw-bold text-primary mb-1">
            <i class="bi bi-calendar3-week me-2"></i>CẤU HÌNH & XẾP THỜI KHÓA BIỂU TỰ ĐỘNG
        </h3>
        <p class="text-muted mb-0">Hỗ trợ xếp theo phạm vi lớp (3A, 4B...), khóa Chào cờ & Sinh hoạt lớp, tinh chỉnh kéo thả nháp và tự động giải OR-Tools.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap d-print-none">
        <button type="button" class="btn btn-outline-primary fw-bold shadow-sm" onclick="showModalTaoBanTkb()">
            <i class="bi bi-plus-circle me-1"></i>Tạo Bản TKB Mới
        </button>
        @if (banTkbHienTai != null)
        {
            string st = banTkbHienTai.TrangThai ?? "";
            bool canConfig = st == "NHAP_DAU_VAO" || st == "DA_XAC_NHAN" || st == "XEP_THAT_BAI";
            bool canSchedule = st == "DA_XAC_NHAN" || st == "XEP_THAT_BAI" || st == "LICH_NHAP" || st == "CHO_GV_XAC_NHAN";
            bool canDraftFlow = st == "LICH_NHAP" || st == "CHO_GV_XAC_NHAN";
            bool canPublish = st == "DA_DUYET";

            <button type="button" class="btn btn-primary fw-bold shadow-sm" onclick="openConfigModal()" disabled="@(!canConfig)">
                <i class="bi bi-sliders me-1"></i>1. Cấu Hình Đợt Xếp
            </button>
            <button type="button" class="btn btn-info fw-bold text-white shadow-sm" onclick="triggerPreCheck()" disabled="@(!canConfig)">
                <i class="bi bi-shield-check me-1"></i>2. Kiểm Tra Đầu Vào
            </button>
            <button type="button" class="btn btn-secondary fw-bold shadow-sm" onclick="triggerChotDauVao()" disabled="@(!canConfig)">
                <i class="bi bi-lock me-1"></i>3. Chốt Đầu Vào
            </button>
            <button type="button" class="btn btn-success fw-bold shadow-sm" onclick="triggerAutoSchedule(@banTkbHienTai.Id)" disabled="@(!canSchedule)">
                <i class="bi bi-magic me-1"></i>4. Chạy Xếp OR-Tools
            </button>
            @if (canDraftFlow)
            {
                <button type="button" class="btn btn-outline-info fw-bold shadow-sm" onclick="guiGvXacNhan(@banTkbHienTai.Id)">
                    <i class="bi bi-send-check me-1"></i>5. Gửi GV Xác Nhận Nháp
                </button>
            }
            <button type="button" class="btn btn-warning fw-bold text-dark shadow-sm" onclick="duyetBanTkb(@banTkbHienTai.Id)" disabled="@(!canDraftFlow)">
                <i class="bi bi-check2-all me-1"></i>6. Duyệt Lịch
            </button>
            <button type="button" class="btn btn-danger fw-bold shadow-sm" onclick="congBoBanTkb(@banTkbHienTai.Id)" disabled="@(!canPublish)">
                <i class="bi bi-broadcast me-1"></i>7. Công Bố Toàn Trường
            </button>
        }
    </div>
</div>

<!-- BỘ LỌC XEM LỊCH THEO LỚP HOẶC GIÁO VIÊN -->
<div class="card border-0 shadow-sm rounded-3 mb-4 d-print-none">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">Chọn Bản Thời Khóa Biểu:</label>
                <select name="banTkbId" class="form-select fw-bold text-dark" onchange="this.form.submit()">
                    @if (dsBanTkb != null && dsBanTkb.Any())
                    {
                        foreach (var b in dsBanTkb)
                        {
                            <option value="@b.Id" selected="@(b.Id == selectedBanTkbId)">
                                [v@(b.SoPhienBan)] @(b.HocKy?.NamHoc?.TenNamHoc) - Học kỳ @b.HocKy?.SoHocKy (@b.TrangThai)
                            </option>
                        }
                    }
                    else
                    {
                        <option value="0">--- Chưa có bản TKB nào ---</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Chế độ xem:</label>
                <select name="viewType" class="form-select fw-bold" onchange="this.form.submit()">
                    <option value="class" selected="@(viewType == "class")">Xem theo Lớp Học</option>
                    <option value="teacher" selected="@(viewType == "teacher")">Xem theo Giáo Viên</option>
                </select>
            </div>
            @if (viewType == "teacher")
            {
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Chọn Giáo Viên:</label>
                    <select name="giaoVienId" class="form-select fw-bold text-info" onchange="this.form.submit()">
                        @if (allGiaoVien != null && allGiaoVien.Any())
                        {
                            foreach (var gv in allGiaoVien)
                            {
                                <option value="@gv.Id" selected="@(gv.Id == selectedGvId)">
                                    @gv.HoTen
                                </option>
                            }
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Chọn Lớp Học:</label>
                    <select name="lopHocId" class="form-select fw-bold text-primary" onchange="this.form.submit()">
                        @if (dsLop != null && dsLop.Any())
                        {
                            foreach (var lop in dsLop)
                            {
                                <option value="@lop.Id" selected="@(lop.Id == selectedLopId)">
                                    Lớp @lop.TenLop - GVCN: @(lop.GiaoVienChuNhiem != null ? lop.GiaoVienChuNhiem.HoTen : "Chưa có")
                                </option>
                            }
                        }
                        else
                        {
                            <option value="0">--- Không có lớp trong đợt ---</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2 text-end">
                <button type="button" class="btn btn-outline-secondary w-100" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i>In Lịch
                </button>
            </div>
        </form>
    </div>
</div>

@if (banTkbHienTai != null)
{
    <!-- THÔNG TIN TRẠNG THÁI BẢN TKB (CHỈ HIỆN TRÊN MÀN HÌNH) -->
    <div class="alert alert-info border-0 rounded-3 shadow-sm d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 d-print-none">
        <div>
            <strong>Trạng thái Bản TKB:</strong> 
            @switch (banTkbHienTai.TrangThai)
            {
                case "NHAP_DAU_VAO":
                    <span class="badge bg-secondary fs-6 ms-1">MỚI TẠO / CẤU HÌNH</span>
                    break;
                case "DA_XAC_NHAN":
                    <span class="badge bg-primary fs-6 ms-1">ĐÃ CHỐT ĐẦU VÀO</span>
                    break;
                case "DANG_XEP":
                    <span class="badge bg-warning text-dark fs-6 ms-1"><span class="spinner-border spinner-border-sm me-1"></span>ĐANG XẾP LỊCH...</span>
                    break;
                case "LICH_NHAP":
                    <span class="badge bg-success fs-6 ms-1">LỊCH NHÁP (CHO PHÉP KÉO THẢ)</span>
                    break;
                case "CHO_GV_XAC_NHAN":
                    <span class="badge bg-info text-dark fs-6 ms-1">CHỜ GIÁO VIÊN XÁC NHẬN NHÁP</span>
                    break;
                case "DA_DUYET":
                    <span class="badge bg-warning text-dark fs-6 ms-1">ĐÃ DUYỆT (CHỜ CÔNG BỐ)</span>
                    break;
                case "DA_CONG_BO":
                    <span class="badge bg-danger fs-6 ms-1">ĐÃ CÔNG BỐ TOÀN TRƯỜNG</span>
                    break;
                case "XEP_THAT_BAI":
                    <span class="badge bg-danger fs-6 ms-1">XẾP THẤT BÀI</span>
                    break;
                default:
                    <span class="badge bg-dark fs-6 ms-1">@banTkbHienTai.TrangThai</span>
                    break;
            }
            <span class="text-muted ms-3 small">
                Hiệu lực: <strong>@(banTkbHienTai.TuNgay?.ToString("dd/MM/yyyy") ?? "---")</strong> đến <strong>@(banTkbHienTai.DenNgay?.ToString("dd/MM/yyyy") ?? "Vô thời hạn")</strong>
            </span>
        </div>
        @if (!string.IsNullOrEmpty(banTkbHienTai.BaoCaoXepLich))
        {
            <div class="small text-dark mt-1 w-100 p-2 bg-light rounded border">
                <i class="bi bi-info-circle me-1 text-primary"></i><strong>Nhật ký bộ giải:</strong> @banTkbHienTai.BaoCaoXepLich
            </div>
        }
    </div>

    <!-- KHU VỰC KÉO THẢ TINH CHỈNH LỊCH NHÁP -->
    @if (banTkbHienTai.TrangThai == "LICH_NHAP" || banTkbHienTai.TrangThai == "CHO_GV_XAC_NHAN")
    {
        <div class="card border-warning shadow-sm mb-4 bg-warning bg-opacity-10 d-print-none">
            <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h6 class="fw-bold text-dark mb-1"><i class="bi bi-arrows-move me-2 text-warning"></i>CHẾ ĐỘ TINH CHỈNH LỊCH NHÁP</h6>
                    <small class="text-muted">Kéo thả các tiết giữa các ô, hoặc gửi bản nháp này cho Giáo viên xem và xác nhận trước khi duyệt.</small>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-dark fw-bold" onclick="reSolveRemaining(@banTkbHienTai.Id)">
                        <i class="bi bi-arrow-repeat me-1"></i>Xếp Lại Các Tiết Còn Thiếu
                    </button>
                </div>
            </div>
        </div>
    }

    var dsXacNhanGv = ViewBag.DsXacNhanGv as List<QLHS.Models.BanTkbXacNhanGv>;
    @if (dsXacNhanGv != null && dsXacNhanGv.Any())
    {
        int soDongY = dsXacNhanGv.Count(x => x.TrangThai == "DA_XAC_NHAN");
        int soYeuCauSua = dsXacNhanGv.Count(x => x.TrangThai == "CAN_DIEU_CHINH");
        int soCho = dsXacNhanGv.Count(x => x.TrangThai == "CHO_XAC_NHAN");
        <div class="card border-0 shadow-sm rounded-3 mb-4 d-print-none">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-people-fill me-2"></i>TRẠNG THÁI GIÁO VIÊN XÁC NHẬN BẢN NHÁP [v@(banTkbHienTai.SoPhienBan)]
                </h6>
                <div class="d-flex gap-2 small align-items-center flex-wrap">
                    <span class="badge bg-success">Đồng ý: @soDongY/@dsXacNhanGv.Count</span>
                    <span class="badge bg-warning text-dark">Chờ phản hồi: @soCho</span>
                    <span class="badge bg-danger">Yêu cầu sửa: @soYeuCauSua</span>
                    @if (soCho > 0 && (banTkbHienTai.TrangThai == "CHO_GV_XAC_NHAN" || banTkbHienTai.TrangThai == "LICH_NHAP"))
                    {
                        <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2 fw-semibold"
                                onclick="adminXacNhanThay(@banTkbHienTai.Id, null)">
                            <i class="bi bi-check2-all me-1"></i>Xác nhận thay tất cả GV chưa phản hồi
                        </button>
                    }
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 220px; overflow-y: auto;">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Giáo Viên</th>
                                <th class="text-center">Trạng Thái</th>
                                <th>Ý Kiến / Yêu Cầu Sửa Đổi</th>
                                <th class="pe-3 text-end">Thời Gian / Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var xn in dsXacNhanGv)
                            {
                                <tr class="@(xn.TrangThai == "CAN_DIEU_CHINH" ? "table-danger bg-opacity-10" : "")">
                                    <td class="ps-3 fw-semibold">@(xn.GiaoVien?.HoTen ?? "---")</td>
                                    <td class="text-center">
                                        @if (xn.TrangThai == "DA_XAC_NHAN")
                                        {
                                            <span class="badge bg-success">Đã đồng ý</span>
                                        }
                                        else if (xn.TrangThai == "CAN_DIEU_CHINH")
                                        {
                                            <span class="badge bg-danger">Yêu cầu sửa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Chờ xác nhận</span>
                                        }
                                    </td>
                                    <td class="small @(xn.TrangThai == "CAN_DIEU_CHINH" ? "text-danger fw-semibold" : "text-muted")">
                                        @(string.IsNullOrWhiteSpace(xn.YKien) ? "---" : xn.YKien)
                                    </td>
                                    <td class="pe-3 text-end small text-muted">
                                        @if (xn.TrangThai == "CHO_XAC_NHAN" && (banTkbHienTai.TrangThai == "CHO_GV_XAC_NHAN" || banTkbHienTai.TrangThai == "LICH_NHAP"))
                                        {
                                            <button type="button" class="btn btn-xs btn-outline-success py-0 px-2"
                                                    onclick="adminXacNhanThay(@banTkbHienTai.Id, @xn.GiaoVienId)">
                                                <i class="bi bi-check-lg me-1"></i>Xác nhận thay
                                            </button>
                                        }
                                        else
                                        {
                                            @(xn.NgayPhanHoi?.ToString("HH:mm dd/MM") ?? "---")
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- TIÊU ĐỀ IN ẤN (CHỈ HIỆN KHI IN) -->
    <div class="d-none d-print-block text-center mb-3">
        <h4 class="fw-bold text-uppercase mb-1">
            @(viewType == "teacher"
                ? $"THỜI KHÓA BIỂU GIẢNG DẠY - {(giaoVienHienTai?.HoTen ?? "---")}"
                : $"THỜI KHÓA BIỂU LỚP {(lopHocHienTai?.TenLop ?? "---")}")
        </h4>
        <div class="small">
            Năm học: <strong>@(banTkbHienTai.HocKy?.NamHoc?.TenNamHoc ?? "---")</strong> |
            Học kỳ: <strong>@(banTkbHienTai.HocKy?.SoHocKy)</strong> |
            Bản TKB số: <strong>@banTkbHienTai.SoPhienBan</strong> |
            Áp dụng: <strong>@(banTkbHienTai.TuNgay?.ToString("dd/MM/yyyy") ?? "---")</strong> – <strong>@(banTkbHienTai.DenNgay?.ToString("dd/MM/yyyy") ?? "Hết học kỳ")</strong>
            @if (viewType != "teacher")
            {
                <span> | GVCN: <strong>@(lopHocHienTai?.GiaoVienChuNhiem?.HoTen ?? "Chưa phân công")</strong></span>
            }
        </div>
    </div>

    <!-- BẢNG LƯỚI THỜI KHÓA BIỂU -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center d-print-none">
            <h5 class="fw-bold mb-0 text-dark">
                @if (viewType == "teacher")
                {
                    <span><i class="bi bi-person-badge me-2 text-info"></i>Lịch giảng dạy: Thầy/Cô @(giaoVienHienTai?.HoTen ?? "---")</span>
                }
                else
                {
                    <span><i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Lịch học: Lớp @(lopHocHienTai?.TenLop ?? "---") (GVCN: @(lopHocHienTai?.GiaoVienChuNhiem?.HoTen ?? "Chưa có"))</span>
                }
            </h5>
            <span class="badge bg-light text-dark border">
                Tổng số tiết: <strong>@(Model?.Count() ?? 0)</strong> tiết/tuần
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th style="width: 100px;">Buổi</th>
                        <th style="width: 80px;">Tiết</th>
                        <th>Thứ 2</th>
                        <th>Thứ 3</th>
                        <th>Thứ 4</th>
                        <th>Thứ 5</th>
                        <th>Thứ 6</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- SÁNG -->
                    @for (int tiet = 1; tiet <= 4; tiet++)
                    {
                        <tr>
                            @if (tiet == 1)
                            {
                                <td rowspan="4" class="fw-bold bg-light align-middle text-primary">
                                    <i class="bi bi-sun-fill me-1 text-warning"></i>SÁNG
                                </td>
                            }
                            <td class="fw-bold bg-light">Tiết @tiet</td>
                            @for (int thu = 2; thu <= 6; thu++)
                            {
                                var item = GetSlot(thu, tiet, "SANG");
                                bool isChaoCo = (thu == 2 && tiet == 1);
                                bool allowDrag = viewType != "teacher" && !isChaoCo && (banTkbHienTai.TrangThai == "LICH_NHAP" || banTkbHienTai.TrangThai == "CHO_GV_XAC_NHAN");
                                if (item != null)
                                {
                                    <td class="@(isChaoCo ? "bg-danger bg-opacity-10 border-danger" : "bg-primary bg-opacity-10") p-2 slot-cell"
                                        draggable="@(allowDrag ? "true" : "false")"
                                        style="@(allowDrag ? "cursor: grab;" : "")"
                                        data-slot-id="@item.KhungTietId" data-thu="@thu" data-tiet="@tiet" data-buoi="SANG"
                                        ondragstart="onDragStartSlot(event, @(item.KhungTietId ?? 0), @(item.MonHocId ?? 0), @(item.GiaoVienId ?? 0), @(item.PhanCongId ?? 0))"
                                        ondragover="onDragOver(event)" ondrop="onDropSlot(event, @(item.KhungTietId ?? 0))">
                                        <div class="fw-bold @(isChaoCo ? "text-danger" : "text-primary")">
                                            @if (isChaoCo)
                                            {
                                                <i class="bi bi-flag-fill me-1"></i><span>CHÀO CỜ</span>
                                            }
                                            else
                                            {
                                                @item.MonHoc?.TenMon
                                            }
                                        </div>
                                        <div class="small text-muted">
                                            @if (viewType == "teacher")
                                            {
                                                <i class="bi bi-door-open me-1"></i>@(item.LopHoc?.TenLop ?? "---")
                                            }
                                            else
                                            {
                                                <i class="bi bi-person me-1"></i>@(item.GiaoVien?.HoTen ?? "---")
                                            }
                                        </div>
                                        @if (isChaoCo)
                                        {
                                            <span class="badge bg-danger mt-1" style="font-size: 0.65rem;"><i class="bi bi-lock-fill me-1"></i>CỐ ĐỊNH</span>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td class="text-muted small bg-white slot-cell" data-thu="@thu" data-tiet="@tiet" data-buoi="SANG"
                                        ondragover="onDragOver(event)" ondrop="onDropEmpty(event, @thu, @tiet, 'SANG')">
                                        ---
                                    </td>
                                }
                            }
                        </tr>
                    }

                    <!-- PHÂN CÁCH NGHỈ TRƯA -->
                    <tr class="table-secondary">
                        <td colspan="7" class="py-1 text-muted small fw-semibold">--- NGHỈ TRƯA ---</td>
                    </tr>

                    <!-- CHIỀU -->
                    @for (int tiet = 1; tiet <= 3; tiet++)
                    {
                        <tr>
                            @if (tiet == 1)
                            {
                                <td rowspan="3" class="fw-bold bg-light align-middle text-warning">
                                    <i class="bi bi-moon-stars-fill me-1 text-warning"></i>CHIỀU
                                </td>
                            }
                            <td class="fw-bold bg-light">Tiết @tiet</td>
                            @for (int thu = 2; thu <= 6; thu++)
                            {
                                var item = GetSlot(thu, tiet, "CHIEU");
                                bool isSinhHoat = (thu == 6 && tiet == 3);
                                bool allowDragChieu = viewType != "teacher" && !isSinhHoat && (banTkbHienTai.TrangThai == "LICH_NHAP" || banTkbHienTai.TrangThai == "CHO_GV_XAC_NHAN");
                                if (item != null)
                                {
                                    <td class="@(isSinhHoat ? "bg-success bg-opacity-10 border-success" : "bg-warning bg-opacity-10") p-2 slot-cell"
                                        draggable="@(allowDragChieu ? "true" : "false")"
                                        style="@(allowDragChieu ? "cursor: grab;" : "")"
                                        data-slot-id="@item.KhungTietId" data-thu="@thu" data-tiet="@tiet" data-buoi="CHIEU"
                                        ondragstart="onDragStartSlot(event, @(item.KhungTietId ?? 0), @(item.MonHocId ?? 0), @(item.GiaoVienId ?? 0), @(item.PhanCongId ?? 0))"
                                        ondragover="onDragOver(event)" ondrop="onDropSlot(event, @(item.KhungTietId ?? 0))">
                                        <div class="fw-bold @(isSinhHoat ? "text-success" : "text-dark")">
                                            @if (isSinhHoat)
                                            {
                                                <i class="bi bi-people-fill me-1"></i><span>SINH HOẠT LỚP</span>
                                            }
                                            else
                                            {
                                                @item.MonHoc?.TenMon
                                            }
                                        </div>
                                        <div class="small text-muted">
                                            @if (viewType == "teacher")
                                            {
                                                <i class="bi bi-door-open me-1"></i>@(item.LopHoc?.TenLop ?? "---")
                                            }
                                            else
                                            {
                                                <i class="bi bi-person me-1"></i>@(item.GiaoVien?.HoTen ?? "---")
                                            }
                                        </div>
                                        @if (isSinhHoat)
                                        {
                                            <span class="badge bg-success mt-1" style="font-size: 0.65rem;"><i class="bi bi-lock-fill me-1"></i>CỐ ĐỊNH (GVCN)</span>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td class="text-muted small bg-white slot-cell" data-thu="@thu" data-tiet="@tiet" data-buoi="CHIEU"
                                        ondragover="onDragOver(event)" ondrop="onDropEmpty(event, @thu, @tiet, 'CHIEU')">
                                        ---
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

