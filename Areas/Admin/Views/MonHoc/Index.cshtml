@model IEnumerable<QLHS.Models.MonHoc>

@{
    ViewData["Title"] = "Quản lý Môn Học";
}

<!-- TIÊU ĐỀ & NÚT THÊM MỚI -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-primary mb-1"><i class="bi bi-journal-bookmark me-2"></i>QUẢN LÝ MÔN HỌC</h3>
        <p class="text-muted mb-0">Danh mục môn học và hình thức đánh giá theo Quy định Thông tư 27/2020/TT-BGDĐT.</p>
    </div>
    <button type="button" class="btn btn-primary fw-bold" onclick="openCreateModal()">
        <i class="bi bi-plus-circle me-1"></i>Thêm Môn Học
    </button>
</div>

<!-- BẢNG DANH SÁCH MÔN HỌC -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Tên Môn Học</th>
                        <th>Hình Thức Đánh Giá (Thông tư 27)</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 text-muted">#@item.Id</td>
                                <td class="fw-bold text-dark">@item.TenMon</td>
                                <td>
                                    @if (item.HinhThucDanhGia == "diem_nhan_xet")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2">
                                            <i class="bi bi-award me-1"></i>Điểm số & Nhận xét
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2">
                                            <i class="bi bi-chat-left-text me-1"></i>Chỉ nhận xét
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(@item.Id)" title="Sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="openDeleteModal(@item.Id, '@item.TenMon')" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Chưa có dữ liệu môn học.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 1. MODAL THÊM MÔN HỌC -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-square me-2"></i>Thêm Môn Học Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="createForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên môn học <span class="text-danger">*</span></label>
                        <input type="text" id="create_TenMon" name="TenMon" class="form-control" placeholder="Ví dụ: Toán, Tiếng Việt, Đạo đức..." />
                        <div class="text-danger small mt-1" id="create_error_TenMon"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình thức đánh giá <span class="text-danger">*</span></label>
                        <select name="HinhThucDanhGia" class="form-select">
                            <option value="diem_nhan_xet">Đánh giá bằng điểm số kết hợp nhận xét</option>
                            <option value="chi_nhan_xet">Chỉ đánh giá bằng nhận xét</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-bold">Lưu Môn Học</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 2. MODAL SỬA MÔN HỌC -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Cập Nhật Môn Học</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="edit_id" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên môn học <span class="text-danger">*</span></label>
                        <input type="text" id="edit_TenMon" name="TenMon" class="form-control" />
                        <div class="text-danger small mt-1" id="edit_error_TenMon"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình thức đánh giá <span class="text-danger">*</span></label>
                        <select id="edit_HinhThucDanhGia" name="HinhThucDanhGia" class="form-select">
                            <option value="diem_nhan_xet">Đánh giá bằng điểm số kết hợp nhận xét</option>
                            <option value="chi_nhan_xet">Chỉ đánh giá bằng nhận xét</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning fw-bold">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- 3. MODAL XÁC NHẬN XÓA -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Xác Nhận Xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="deleteForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="delete_id" name="id" />
                <div class="modal-body text-center py-4">
                    <p class="mb-1">Bạn có chắc muốn xóa môn học:</p>
                    <h5 id="delete_TenMon" class="text-danger fw-bold"></h5>
                    <small class="text-muted">Hành động này không thể hoàn tác!</small>
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger fw-bold">Đồng Ý Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JAVASCRIPT XỬ LÝ AJAX & RÀNG BUỘC CLIENT -->
@section Scripts {
    <script>
        const createModal = new bootstrap.Modal(document.getElementById('createModal'));
        const editModal = new bootstrap.Modal(document.getElementById('editModal'));
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        function openCreateModal() {
            document.getElementById('createForm').reset();
            document.getElementById('create_error_TenMon').innerText = '';
            createModal.show();
        }

        function openEditModal(id) {
            document.getElementById('edit_error_TenMon').innerText = '';
            fetch(`/Admin/MonHoc/GetById/${id}`)
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        document.getElementById('edit_id').value = res.data.id;
                        document.getElementById('edit_TenMon').value = res.data.tenMon;
                        document.getElementById('edit_HinhThucDanhGia').value = res.data.hinhThucDanhGia || 'diem_nhan_xet';
                        editModal.show();
                    } else {
                        alert(res.message);
                    }
                });
        }

        function openDeleteModal(id, tenMon) {
            document.getElementById('delete_id').value = id;
            document.getElementById('delete_TenMon').innerText = tenMon;
            deleteModal.show();
        }

        // Validate Client
        function validateTenMon(value) {
            if (!value || value.trim() === '') {
                return 'Tên môn học không được để trống!';
            }
            if (value.trim().length < 2) {
                return 'Tên môn học phải chứa ít nhất 2 ký tự!';
            }
            return null;
        }

        // Submit Form Thêm Mới
        document.getElementById('createForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const tenMon = document.getElementById('create_TenMon').value;
            const errorMsg = validateTenMon(tenMon);

            if (errorMsg) {
                document.getElementById('create_error_TenMon').innerText = errorMsg;
                return;
            }
            document.getElementById('create_error_TenMon').innerText = '';

            fetch('/Admin/MonHoc/Create', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    document.getElementById('create_error_TenMon').innerText = res.message;
                }
            });
        });

        // Submit Form Sửa
        document.getElementById('editForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const tenMon = document.getElementById('edit_TenMon').value;
            const errorMsg = validateTenMon(tenMon);

            if (errorMsg) {
                document.getElementById('edit_error_TenMon').innerText = errorMsg;
                return;
            }
            document.getElementById('edit_error_TenMon').innerText = '';

            fetch('/Admin/MonHoc/Edit', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    document.getElementById('edit_error_TenMon').innerText = res.message;
                }
            });
        });

        // Submit Form Xóa
        document.getElementById('deleteForm').addEventListener('submit', function (e) {
            e.preventDefault();
            fetch('/Admin/MonHoc/Delete', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        });
    </script>
}