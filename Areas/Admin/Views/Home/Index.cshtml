@model IEnumerable<QLHS.Models.HocSinh>

@{
    ViewData["Title"] = "Bảng Quản Trị Hệ Thống";
}

<!-- HEADER TIÊU ĐỀ -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-primary mb-1">
            <i class="bi bi-speedometer2 me-2"></i>DASHBOARD QUẢN TRỊ ADMIN
        </h3>
        <p class="text-muted mb-0">Tổng quan hệ thống và các chỉ số hoạt động toàn trường.</p>
    </div>
    <div>
        <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm">
            <i class="bi bi-calendar3 me-1"></i>Năm học: 2026 - 2027
        </span>
    </div>
</div>

<!-- 1. CÁC THẺ THỐNG KÊ CỐ ĐỊNH (STATS CARDS) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 bg-primary text-white h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-white-50 text-uppercase small fw-bold">Tổng Học sinh</span>
                    <h2 class="fw-bold mb-0 mt-1">@ViewBag.TongHocSinh</h2>
                </div>
                <div class="bg-white bg-opacity-25 p-3 rounded-circle d-flex align-items-center justify-content-center">
                    <i class="bi bi-people-fill fs-2 text-white"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 bg-success text-white h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-white-50 text-uppercase small fw-bold">Tổng Giáo viên</span>
                    <h2 class="fw-bold mb-0 mt-1">@ViewBag.TongGiaoVien</h2>
                </div>
                <div class="bg-white bg-opacity-25 p-3 rounded-circle d-flex align-items-center justify-content-center">
                    <i class="bi bi-person-badge-fill fs-2 text-white"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 bg-warning text-dark h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-black-50 text-uppercase small fw-bold">Số Lớp học</span>
                    <h2 class="fw-bold mb-0 mt-1">@ViewBag.TongLopHoc</h2>
                </div>
                <div class="bg-white bg-opacity-25 p-3 rounded-circle d-flex align-items-center justify-content-center">
                    <i class="bi bi-door-open-fill fs-2 text-dark"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 bg-info text-white h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-white-50 text-uppercase small fw-bold">Tài khoản Kích hoạt</span>
                    <h2 class="fw-bold mb-0 mt-1">@ViewBag.TongTaiKhoan</h2>
                </div>
                <div class="bg-white bg-opacity-25 p-3 rounded-circle d-flex align-items-center justify-content-center">
                    <i class="bi bi-shield-check fs-2 text-white"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. BIỂU ĐỒ & THAO TÁC NHANH -->
<div class="row g-4 mb-4">
    <!-- Cột trái: Biểu đồ phân bổ học sinh -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-line me-2 text-primary"></i>Phân bổ Học sinh theo Khối</h5>
                <span class="badge bg-light text-dark border">Khối 1 - Khối 5</span>
            </div>
            <div class="card-body">
                <canvas id="khoiChart" style="max-height: 280px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Cột phải: Lối tắt quản lý (Quick Actions) -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-lightning-charge me-2 text-warning"></i>Lối Tắt Quản Lý</h5>
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a href="#" class="btn btn-outline-primary text-start p-3 rounded-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-bold"><i class="bi bi-person-plus me-2"></i>Thêm Học Sinh Mới</div>
                        <small class="text-muted">Đăng ký hồ sơ học sinh đầu năm</small>
                    </div>
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#" class="btn btn-outline-success text-start p-3 rounded-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-bold"><i class="bi bi-person-workspace me-2"></i>Phân Công Giảng Dạy</div>
                        <small class="text-muted">Gán giáo viên bộ môn & GVCN</small>
                    </div>
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#" class="btn btn-outline-warning text-dark text-start p-3 rounded-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-bold"><i class="bi bi-calendar-week me-2"></i>Tự Động Xếp TKB</div>
                        <small class="text-muted">Xếp thời khóa biểu toàn trường</small>
                    </div>
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#" class="btn btn-outline-info text-start p-3 rounded-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-bold"><i class="bi bi-gear me-2"></i>Cấu Hình Danh Mục</div>
                        <small class="text-muted">Năm học, khối lớp, môn học</small>
                    </div>
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- 3. BẢNG DANH SÁCH HỌC SINH MỚI CẬP NHẬT -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history me-2 text-success"></i>Học Sinh Mới Nhập Học</h5>
        <a href="#" class="btn btn-sm btn-light border text-primary fw-semibold">Xem tất cả <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Mã HS</th>
                    <th>Họ và Tên</th>
                    <th>Ngày sinh</th>
                    <th>Giới tính</th>
                    <th>Lớp hiện tại</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var hs in Model)
                    {
                        <tr>
                            <td class="ps-3"><span class="badge bg-secondary">@hs.MaHocSinh</span></td>
                            <td class="fw-bold text-dark">@hs.HoTen</td>
                            <td>@(hs.NgaySinh.HasValue ? hs.NgaySinh.Value.ToString("dd/MM/yyyy") : "---")</td>
                            <td>
                                @if (hs.GioiTinh == "Nam")
                                {
                                    <span class="text-primary"><i class="bi bi-gender-male me-1"></i>Nam</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="bi bi-gender-female me-1"></i>Nữ</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(hs.LopHocHienTai != null ? "Lớp " + hs.LopHocHienTai.TenLop : "Chưa xếp lớp")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">Đang học</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Chưa có dữ liệu học sinh mới.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- SCRIPT VẼ BIỂU ĐỒ (CHART.JS) -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('khoiChart').getContext('2d');
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.KhoiLabels ?? new string[] { }));
        const dataValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.KhoiData ?? new int[] { }));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Số lượng học sinh',
                    data: dataValues,
                    backgroundColor: [
                        'rgba(13, 110, 253, 0.75)',
                        'rgba(25, 135, 84, 0.75)',
                        'rgba(255, 193, 7, 0.75)',
                        'rgba(13, 202, 240, 0.75)',
                        'rgba(111, 66, 193, 0.75)'
                    ],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    </script>
}