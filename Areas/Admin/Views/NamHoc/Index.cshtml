@model IEnumerable<QLHS.Models.NamHoc>

@{
    ViewData["Title"] = "Quản lý Năm Học";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-primary mb-1"><i class="bi bi-calendar-range me-2"></i>QUẢN LÝ NĂM HỌC</h3>
        <p class="text-muted mb-0">Cấu hình danh mục năm học và học kỳ áp dụng toàn trường.</p>
    </div>
    <button type="button" class="btn btn-primary fw-bold" onclick="openCreateModal()">
        <i class="bi bi-plus-circle me-1"></i>Thêm Cấu Hình
    </button>
</div>

<!-- BẢNG DANH SÁCH -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Tên Năm Học</th>
                        <th>Học Kỳ</th>
                        <th>Trạng Thái Khóa</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 text-muted">#@item.Id</td>
                                <td class="fw-bold text-dark">@item.TenNamHoc</td>
                                <td>
                                    <span class="badge bg-info text-dark">Học kỳ @item.HocKyHienTai</span>
                                </td>
                                <td>
                                    @if (item.DangMoKhoa.HasValue && item.DangMoKhoa.Value)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">Đang mở</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">Đã khóa</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(@item.Id)" title="Sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="openDeleteModal(@item.Id, '@item.TenNamHoc - Học kỳ @item.HocKyHienTai')" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu năm học.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 1. MODAL THÊM NĂM HỌC -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-calendar-plus me-2"></i>Thêm Cấu Hình Năm Học</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="createForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên năm học <span class="text-danger">*</span></label>
                        <input type="text" id="create_TenNamHoc" name="TenNamHoc" class="form-control" placeholder="Ví dụ: 2026-2027" />
                        <div class="text-danger small mt-1" id="create_error_TenNamHoc"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Học kỳ <span class="text-danger">*</span></label>
                        <select name="HocKyHienTai" class="form-select">
                            <option value="1">Học kỳ 1</option>
                            <option value="2">Học kỳ 2</option>
                        </select>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="create_DangMoKhoa" name="DangMoKhoa" value="true" checked />
                        <label class="form-check-label fw-bold" for="create_DangMoKhoa">Đang mở khóa dữ liệu</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-bold">Lưu Cấu Hình</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 2. MODAL SỬA NĂM HỌC -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Cập Nhật Cấu Hình</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="edit_id" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên năm học <span class="text-danger">*</span></label>
                        <input type="text" id="edit_TenNamHoc" name="TenNamHoc" class="form-control" />
                        <div class="text-danger small mt-1" id="edit_error_TenNamHoc"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Học kỳ <span class="text-danger">*</span></label>
                        <select id="edit_HocKyHienTai" name="HocKyHienTai" class="form-select">
                            <option value="1">Học kỳ 1</option>
                            <option value="2">Học kỳ 2</option>
                        </select>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="edit_DangMoKhoa" name="DangMoKhoa" value="true" />
                        <label class="form-check-label fw-bold" for="edit_DangMoKhoa">Đang mở khóa dữ liệu</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning fw-bold">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 3. MODAL XÁC NHẬN XÓA -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Xác Nhận Xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="deleteForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="delete_id" name="id" />
                <div class="modal-body text-center py-4">
                    <p class="mb-1">Bạn có chắc muốn xóa bản ghi:</p>
                    <h5 id="delete_TenNamHoc" class="text-danger fw-bold"></h5>
                    <small class="text-muted">Hành động này không thể hoàn tác!</small>
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger fw-bold">Đồng Ý Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const createModal = new bootstrap.Modal(document.getElementById('createModal'));
        const editModal = new bootstrap.Modal(document.getElementById('editModal'));
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        function openCreateModal() {
            document.getElementById('createForm').reset();
            document.getElementById('create_error_TenNamHoc').innerText = '';
            createModal.show();
        }

        function openEditModal(id) {
            document.getElementById('edit_error_TenNamHoc').innerText = '';
            fetch(`/Admin/NamHoc/GetById/${id}`)
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        document.getElementById('edit_id').value = res.data.id;
                        document.getElementById('edit_TenNamHoc').value = res.data.tenNamHoc;
                        document.getElementById('edit_HocKyHienTai').value = res.data.hocKyHienTai || 1;
                        document.getElementById('edit_DangMoKhoa').checked = res.data.dangMoKhoa === true;
                        editModal.show();
                    } else {
                        alert(res.message);
                    }
                });
        }

        function openDeleteModal(id, tenNamHoc) {
            document.getElementById('delete_id').value = id;
            document.getElementById('delete_TenNamHoc').innerText = tenNamHoc;
            deleteModal.show();
        }

        function validateTenNamHoc(value) {
            if (!value || value.trim() === '') {
                return 'Tên năm học không được để trống!';
            }
            
            const regex = /^\d{4}-\d{4}$/;
            if (!regex.test(value.trim())) {
                return 'Tên năm học phải có định dạng YYYY-YYYY (Ví dụ: 2026-2027)!';
            }

            const parts = value.split('-');
            if (parseInt(parts[1]) !== parseInt(parts[0]) + 1) {
                return 'Năm kết thúc phải lớn hơn năm bắt đầu đúng 1 năm!';
            }

            return null;
        }

        document.getElementById('createForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const tenNamHoc = document.getElementById('create_TenNamHoc').value;
            const errorMsg = validateTenNamHoc(tenNamHoc);

            if (errorMsg) {
                document.getElementById('create_error_TenNamHoc').innerText = errorMsg;
                return;
            }

            fetch('/Admin/NamHoc/Create', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    document.getElementById('create_error_TenNamHoc').innerText = res.message;
                }
            });
        });

        document.getElementById('editForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const tenNamHoc = document.getElementById('edit_TenNamHoc').value;
            const errorMsg = validateTenNamHoc(tenNamHoc);

            if (errorMsg) {
                document.getElementById('edit_error_TenNamHoc').innerText = errorMsg;
                return;
            }

            fetch('/Admin/NamHoc/Edit', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    document.getElementById('edit_error_TenNamHoc').innerText = res.message;
                }
            });
        });

        document.getElementById('deleteForm').addEventListener('submit', function (e) {
            e.preventDefault();
            fetch('/Admin/NamHoc/Delete', {
                method: 'POST',
                body: new FormData(this)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        });
    </script>
}