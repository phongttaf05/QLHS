@model IEnumerable<QLHS.Models.PhanCongGiangDay>

@{
    ViewData["Title"] = "Phân Công Giảng Dạy Của Tôi";
    int soBanNhapChoXn = ViewBag.SoBanNhapChoXn ?? 0;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-area="GiaoVien" asp-controller="Home" asp-action="Index" class="text-decoration-none text-success"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Phân công giảng dạy</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h3 class="fw-bold text-success mb-1">
            <i class="bi bi-journal-check me-2"></i>PHÂN CÔNG GIẢNG DẠY CỦA TÔI
        </h3>
        <p class="text-muted mb-0">Danh sách lớp và môn học Ban Giám Hiệu phân công cho Thầy/Cô <strong>@ViewBag.TenGiaoVien</strong>.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="GiaoVien" asp-controller="ThoiKhoaBieu" asp-action="Index"
           asp-route-mode="@(soBanNhapChoXn > 0 ? "nhap" : "chinh-thuc")"
           class="btn @(soBanNhapChoXn > 0 ? "btn-warning text-dark" : "btn-outline-success") fw-bold shadow-sm">
            <i class="bi bi-calendar3-week me-1"></i>
            @if (soBanNhapChoXn > 0)
            {
                <span>Xem & Xác Nhận TKB Nháp (@soBanNhapChoXn)</span>
            }
            else
            {
                <span>Xem Thời Khóa Biểu</span>
            }
        </a>
    </div>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger rounded-4 shadow-sm">@ViewBag.ErrorMessage</div>
}

@if (soBanNhapChoXn > 0)
{
    <div class="alert alert-warning border-0 rounded-4 shadow-sm d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <i class="bi bi-bell-fill text-danger me-2"></i>
            <strong>Ban Giám Hiệu đã gửi @soBanNhapChoXn bản TKB nháp</strong> cần Thầy/Cô kiểm tra và xác nhận (hoặc góp ý sửa đổi).
        </div>
        <a asp-area="GiaoVien" asp-controller="ThoiKhoaBieu" asp-action="Index" asp-route-mode="nhap" class="btn btn-sm btn-danger fw-bold">
            Đi tới xác nhận ngay <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-list-check text-primary me-2"></i>DANH SÁCH MÔN HỌC ĐƯỢC PHÂN CÔNG
        </h5>
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2">
            Tổng cộng: @(Model?.Count() ?? 0) môn (@(Model?.Sum(m => m.SoTietTuan ?? 0) ?? 0) tiết/tuần)
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Học kỳ / Năm học</th>
                        <th>Lớp học</th>
                        <th>Môn học</th>
                        <th class="text-center">Số tiết/tuần</th>
                        <th class="pe-4">Thời gian hiệu lực</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <strong class="text-dark">@(item.HocKy?.NamHoc?.TenNamHoc ?? "---")</strong>
                                    <span class="badge bg-secondary-subtle text-secondary ms-1">HK @(item.HocKy?.SoHocKy ?? 1)</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2">
                                        Lớp @(item.LopHoc?.TenLop ?? "---")
                                    </span>
                                </td>
                                <td><strong class="text-dark fs-6">@(item.MonHoc?.TenMon ?? "---")</strong></td>
                                <td class="text-center">
                                    <span class="fw-bold text-success fs-6">@(item.SoTietTuan ?? 0)</span> tiết/tuần
                                </td>
                                <td class="small text-muted pe-4">
                                    @(item.TuNgay?.ToString("dd/MM/yyyy") ?? "---") → @(item.DenNgay?.ToString("dd/MM/yyyy") ?? "---")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                                Thầy/Cô chưa có phân công giảng dạy nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
