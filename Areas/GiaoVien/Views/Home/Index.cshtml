@{
    ViewData["Title"] = "Tổng Quan Bàn Làm Việc";
    var dsPhanCong = ViewBag.DanhSachPhanCong as List<QLHS.Models.PhanCongGiangDay>;
    var dsLopChuNhiem = ViewBag.LopChuNhiem as List<QLHS.Models.LopHoc>;
    var dsLopDay = ViewBag.DanhSachLopDay as List<QLHS.Models.LopHoc>;
    var dsHocSinh = ViewBag.DanhSachHocSinh as List<QLHS.Models.HocSinh>;
    int tongSoTiet = dsPhanCong?.Sum(p => p.SoTietTuan ?? 0) ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h3 class="fw-bold text-success mb-1">
            <i class="bi bi-speedometer2 me-2"></i>BÀN LÀM VIỆC GIÁO VIÊN
        </h3>
        <p class="text-muted mb-0">Xin chào Thầy/Cô <strong>@ViewBag.TenGiaoVien</strong>. Chúc thầy cô một ngày làm việc hiệu quả!</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="GiaoVien" asp-controller="ThoiKhoaBieu" asp-action="Index" class="btn btn-success fw-bold shadow-sm">
            <i class="bi bi-calendar3-week me-1"></i>Xem Thời Khóa Biểu
        </a>
    </div>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger rounded-4 shadow-sm">@ViewBag.ErrorMessage</div>
}

<!-- THẺ THỐNG KÊ TỔNG QUAN -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Lớp chủ nhiệm</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@(dsLopChuNhiem?.Count ?? 0)</h3>
                </div>
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                    <i class="bi bi-person-video3 fs-3"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a asp-area="GiaoVien" asp-controller="LopChuNhiem" asp-action="Index" class="text-success small fw-semibold text-decoration-none">
                    Xem danh sách lớp <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Số môn giảng dạy</span>
                    <h3 class="fw-bold text-primary mb-0 mt-1">@(dsPhanCong?.Count ?? 0)</h3>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                    <i class="bi bi-book-half fs-3"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a asp-area="GiaoVien" asp-controller="PhanCong" asp-action="Index" class="text-primary small fw-semibold text-decoration-none">
                    Xem phân công <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Tổng số tiết/tuần</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@tongSoTiet</h3>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                    <i class="bi bi-clock-history fs-3"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a asp-area="GiaoVien" asp-controller="ThoiKhoaBieu" asp-action="Index" class="text-warning small fw-semibold text-decoration-none">
                    Xem lịch tuần <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Học sinh theo dõi</span>
                    <h3 class="fw-bold text-info mb-0 mt-1">@(dsHocSinh?.Count ?? 0)</h3>
                </div>
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a asp-area="GiaoVien" asp-controller="DiemDanh" asp-action="Index" class="text-info small fw-semibold text-decoration-none">
                    Sổ điểm danh <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- LỐI TẮT NGHIỆP VỤ NHANH -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <a asp-area="GiaoVien" asp-controller="ThoiKhoaBieu" asp-action="Index" class="card border-0 shadow-sm rounded-4 p-4 text-decoration-none bg-white text-dark h-100 hover-card">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                    <i class="bi bi-calendar3-week fs-3"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Thời Khóa Biểu</h6>
                    <small class="text-muted">Tra cứu lịch dạy hàng ngày</small>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a asp-area="GiaoVien" asp-controller="PhanCong" asp-action="Index" class="card border-0 shadow-sm rounded-4 p-4 text-decoration-none bg-white text-dark h-100 hover-card">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                    <i class="bi bi-journal-check fs-3"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Phân Công Dạy</h6>
                    <small class="text-muted">Xác nhận phân công BGH giao</small>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a asp-area="GiaoVien" asp-controller="DiemDanh" asp-action="Index" class="card border-0 shadow-sm rounded-4 p-4 text-decoration-none bg-white text-dark h-100 hover-card">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                    <i class="bi bi-check2-square fs-3"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Điểm Danh Ngày</h6>
                    <small class="text-muted">Chuyên cần các lớp phụ trách</small>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a asp-area="GiaoVien" asp-controller="DanhGiaMonHoc" asp-action="Index" class="card border-0 shadow-sm rounded-4 p-4 text-decoration-none bg-white text-dark h-100 hover-card">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                    <i class="bi bi-pencil-square fs-3"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Đánh Giá Môn Học</h6>
                    <small class="text-muted">Nhập điểm & nhận xét TT 27</small>
                </div>
            </div>
        </a>
    </div>
</div>

<style>
.hover-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.hover-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
}
</style>
