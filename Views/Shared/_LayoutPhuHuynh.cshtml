<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cổng Phụ Huynh</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 72px;
            --topbar-height: 64px;
            --ph-sidebar-start: #0c4a6e;
            --ph-sidebar-end: #0369a1;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f0f9ff;
            color: #0f172a;
            overflow-x: hidden;
        }

        .topbar {
            height: var(--topbar-height);
            position: fixed;
            top: 0;
            right: 0;
            left: 0;
            z-index: 1030;
            background-color: #ffffff;
            border-bottom: 2px solid #bae6fd;
            box-shadow: 0 2px 4px rgba(0,0,0,.04);
        }

        .sidebar-wrapper {
            width: var(--sidebar-width);
            position: fixed;
            top: var(--topbar-height);
            bottom: 0;
            left: 0;
            z-index: 1020;
            background: linear-gradient(180deg, var(--ph-sidebar-start) 0%, var(--ph-sidebar-end) 100%);
            transition: all 0.25s ease;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar-brand {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.12);
            background: rgba(0,0,0,0.2);
            text-decoration: none !important;
            transition: background 0.2s ease;
        }

        .sidebar-brand:hover {
            background: rgba(255,255,255,0.15);
        }

        .content-wrapper {
            margin-top: var(--topbar-height);
            margin-left: var(--sidebar-width);
            padding: 24px 28px;
            min-height: calc(100vh - var(--topbar-height) - 56px);
            transition: all 0.25s ease;
        }

        .main-footer {
            margin-left: var(--sidebar-width);
            height: 56px;
            line-height: 56px;
            background-color: #ffffff;
            border-top: 1px solid #e0f2fe;
            transition: all 0.25s ease;
        }

        .sidebar-menu {
            list-style: none;
            padding: 10px 12px;
            margin: 0;
        }

        .sidebar-heading {
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            padding: 14px 12px 6px 12px;
            color: #7dd3fc !important;
            font-weight: 700;
            text-transform: uppercase;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            padding: 11px 14px;
            color: #e0f2fe;
            text-decoration: none;
            white-space: nowrap;
            border-radius: 8px;
            margin-bottom: 3px;
            font-size: 0.92rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .sidebar-menu a:hover {
            background-color: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            transform: translateX(3px);
        }

        .sidebar-menu a.active {
            background: linear-gradient(90deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff;
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(2, 132, 199, 0.35);
        }

        .sidebar-menu i {
            font-size: 1.15rem;
            min-width: 32px;
            display: flex;
            align-items: center;
        }

        body.sidebar-collapsed .sidebar-wrapper {
            width: var(--sidebar-collapsed-width);
        }
        body.sidebar-collapsed .content-wrapper,
        body.sidebar-collapsed .main-footer {
            margin-left: var(--sidebar-collapsed-width);
        }
        body.sidebar-collapsed .menu-text,
        body.sidebar-collapsed .sidebar-heading,
        body.sidebar-collapsed .sidebar-brand-text {
            display: none !important;
        }
        body.sidebar-collapsed .sidebar-menu a {
            justify-content: center;
            padding: 12px 0;
        }
        body.sidebar-collapsed .sidebar-menu i {
            margin: 0 auto;
            font-size: 1.3rem;
        }

        @@media print {
            .topbar, .sidebar-wrapper, .main-footer, .modal, .modal-backdrop {
                display: none !important;
            }
            body {
                background-color: #ffffff !important;
            }
            .content-wrapper {
                margin: 0 !important;
                padding: 0 !important;
                min-height: auto !important;
            }
            .card {
                box-shadow: none !important;
                border: 1px solid #dee2e6 !important;
            }
        }
    </style>
</head>
<body>

    <!-- TOPBAR PHỤ HUYNH -->
    <header class="topbar d-flex align-items-center justify-content-between px-3 px-md-4">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-light btn-sm rounded-circle border shadow-sm p-2 d-flex align-items-center justify-content-center" id="sidebarToggle" type="button" style="width: 38px; height: 38px;">
                <i class="bi bi-list fs-5"></i>
            </button>
            <a asp-area="" asp-controller="PhuHuynh" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none">
                <span class="badge bg-info px-3 py-2 fs-6 rounded-pill text-white">
                    <i class="bi bi-heart-fill me-1"></i>SỔ LIÊN LẠC ĐIỆN TỬ
                </span>
                <span class="text-muted d-none d-md-inline small fw-semibold">| Đồng hành cùng con em học tập</span>
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="dropdown">
                <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border rounded-pill px-3 py-1 shadow-sm" type="button" data-bs-toggle="dropdown">
                    <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.8rem;">
                        PH
                    </div>
                    <span class="fw-semibold small d-none d-sm-inline">@User.Identity?.Name</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2">
                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2 text-primary"></i>Về trang chủ</a></li>
                    @if (User.IsInRole("admin"))
                    {
                        <li><a class="dropdown-item py-2 text-primary" asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="bi bi-shield-lock me-2"></i>Sang trang Admin</a></li>
                    }
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-danger" asp-area="" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- SIDEBAR DÀNH RIÊNG CHO PHỤ HUYNH -->
    <aside class="sidebar-wrapper" id="sidebar">
        <a asp-area="" asp-controller="PhuHuynh" asp-action="Index" class="sidebar-brand d-flex align-items-center gap-2 text-white">
            <i class="bi bi-backpack4-fill text-warning fs-4"></i>
            <span class="sidebar-brand-text fw-bold fs-6">SỔ LIÊN LẠC</span>
        </a>

        <ul class="sidebar-menu">
            <div class="sidebar-heading">TỔNG QUAN</div>
            <li>
                <a asp-area="" asp-controller="PhuHuynh" asp-action="Index" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-speedometer text-info"></i>
                    <span class="menu-text">Hồ Sơ & Tổng Quan</span>
                </a>
            </li>

            <div class="sidebar-heading">KẾT QUẢ HỌC TẬP (TT 27)</div>
            <li>
                <a asp-area="" asp-controller="PhuHuynh" asp-action="BangDiem" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "BangDiem" ? "active" : "")">
                    <i class="bi bi-journal-check text-success"></i>
                    <span class="menu-text">Bảng Điểm Môn Học</span>
                </a>
            </li>
            <li>
                <a asp-area="" asp-controller="PhuHuynh" asp-action="NangLucPhamChat" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "NangLucPhamChat" ? "active" : "")">
                    <i class="bi bi-award text-warning"></i>
                    <span class="menu-text">Năng Lực & Phẩm Chất</span>
                </a>
            </li>

            <div class="sidebar-heading">CHUYÊN CẦN & THỜI KHÓA BIỂU</div>
            <li>
                <a asp-area="" asp-controller="PhuHuynh" asp-action="DiemDanh" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "DiemDanh" ? "active" : "")">
                    <i class="bi bi-calendar-check text-primary"></i>
                    <span class="menu-text">Chuyên Cần Điểm Danh</span>
                </a>
            </li>
            <li>
                <a asp-area="" asp-controller="PhuHuynh" asp-action="ThoiKhoaBieu" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ThoiKhoaBieu" ? "active" : "")">
                    <i class="bi bi-calendar3 text-danger"></i>
                    <span class="menu-text">Thời Khóa Biểu Tuần</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- NỘI DUNG CHÍNH -->
    <main class="content-wrapper">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="main-footer text-center text-muted small">
        &copy; 2026 - Cổng Tra Cứu Phụ Huynh Học Sinh - Trường Tiểu Học
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/loading-overlay.js" asp-append-version="true"></script>
    <script>
        const toggleBtn = document.getElementById('sidebarToggle');
        toggleBtn.addEventListener('click', function () {
            document.body.classList.toggle('sidebar-collapsed');
            localStorage.setItem('ph_sidebar_state', document.body.classList.contains('sidebar-collapsed') ? 'collapsed' : 'expanded');
        });
        if (localStorage.getItem('ph_sidebar_state') === 'collapsed') {
            document.body.classList.add('sidebar-collapsed');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
