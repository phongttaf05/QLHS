<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLHS Tiểu Học</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 72px;
            --topbar-height: 64px;
            --transition-speed: 0.25s;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f4f6f9;
            color: #333;
            overflow-x: hidden;
        }

        /* Topbar Header */
        .topbar {
            height: var(--topbar-height);
            position: fixed;
            top: 0;
            right: 0;
            left: 0;
            z-index: 1030;
            background-color: #ffffff;
            border-bottom: 1px solid #e9ecef;
            box-shadow: 0 1px 3px rgba(0,0,0,.05);
        }

        /* Sidebar Wrapper */
        .sidebar-wrapper {
            width: var(--sidebar-width);
            position: fixed;
            top: var(--topbar-height);
            bottom: 0;
            left: 0;
            z-index: 1020;
            background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
            transition: all var(--transition-speed) ease;
            overflow-y: auto;
            overflow-x: hidden;
            box-shadow: 2px 0 6px rgba(0,0,0,.05);
        }

        .sidebar-wrapper::-webkit-scrollbar {
            width: 5px;
        }
        .sidebar-wrapper::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.15);
            border-radius: 4px;
        }

        /* Content Wrapper */
        .content-wrapper {
            margin-top: var(--topbar-height);
            margin-left: var(--sidebar-width);
            padding: 24px 28px;
            min-height: calc(100vh - var(--topbar-height) - 56px);
            transition: all var(--transition-speed) ease;
        }

        /* Footer */
        .main-footer {
            margin-left: var(--sidebar-width);
            height: 56px;
            line-height: 56px;
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            transition: all var(--transition-speed) ease;
        }

        /* Menu Sidebar */
        .sidebar-menu {
            list-style: none;
            padding: 8px 12px;
            margin: 0;
        }

        .sidebar-heading {
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            padding: 14px 12px 6px 12px;
            color: #94a3b8 !important;
            font-weight: 700;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            padding: 10px 14px;
            color: #cbd5e1;
            text-decoration: none;
            white-space: nowrap;
            border-radius: 8px;
            margin-bottom: 3px;
            font-size: 0.92rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .sidebar-menu a:hover {
            background-color: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            transform: translateX(2px);
        }

        .sidebar-menu a.active {
            background: linear-gradient(90deg, #3b82f6 0%, #2563eb 100%);
            color: #ffffff;
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);
        }

        .sidebar-menu i {
            font-size: 1.15rem;
            min-width: 32px;
            display: flex;
            align-items: center;
        }

        /* Trạng thái thu gọn Sidebar */
        body.sidebar-collapsed .sidebar-wrapper {
            width: var(--sidebar-collapsed-width);
        }

        body.sidebar-collapsed .content-wrapper,
        body.sidebar-collapsed .main-footer {
            margin-left: var(--sidebar-collapsed-width);
        }

        body.sidebar-collapsed .menu-text,
        body.sidebar-collapsed .sidebar-heading,
        body.sidebar-collapsed .badge-pill-menu {
            display: none !important;
        }

        body.sidebar-collapsed .sidebar-menu a {
            justify-content: center;
            padding: 12px 0;
        }

        body.sidebar-collapsed .sidebar-menu i {
            margin: 0 auto;
            font-size: 1.3rem;
        }

        /* Tag vùng Role trên Header */
        .role-badge {
            font-size: 0.75rem;
            padding: 4px 10px;
            border-radius: 20px;
            font-weight: 600;
        }
    </style>
</head>
<body>

    <!-- 1. HEADER (TOPBAR) -->
    <header class="topbar d-flex align-items-center justify-content-between px-3 px-md-4">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-light btn-sm rounded-circle border shadow-sm p-2 d-flex align-items-center justify-content-center" id="sidebarToggle" type="button" style="width: 38px; height: 38px;">
                <i class="bi bi-list fs-5"></i>
            </button>
            <a class="navbar-brand fw-bold text-primary fs-5 m-0 d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-mortarboard-fill text-primary fs-4"></i>
                <span class="d-none d-sm-inline">QLHS TIỂU HỌC</span>
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;

                @if (role == "admin")
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle role-badge d-none d-md-inline-block">
                        <i class="bi bi-shield-lock-fill me-1"></i>QUẢN TRỊ VIÊN
                    </span>
                }
                else if (role == "giao_vien")
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle role-badge d-none d-md-inline-block">
                        <i class="bi bi-person-workspace me-1"></i>GIÁO VIÊN
                    </span>
                }
                else if (role == "phu_huynh")
                {
                    <span class="badge bg-info-subtle text-info border border-info-subtle role-badge d-none d-md-inline-block">
                        <i class="bi bi-heart-fill me-1"></i>PHỤ HUYNH
                    </span>
                }

                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border rounded-pill px-3 py-1 shadow-sm" type="button" data-bs-toggle="dropdown">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.8rem;">
                            @(string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper())
                        </div>
                        <span class="fw-semibold small d-none d-sm-inline">@fullName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2">
                        <li class="px-3 py-2 border-bottom">
                            <span class="d-block small text-muted">Đang đăng nhập với:</span>
                            <strong class="text-dark">@User.Identity.Name</strong>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 text-danger" asp-area="" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="btn btn-primary btn-sm fw-bold rounded-pill px-3 shadow-sm" asp-area="" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                </a>
            }
        </div>
    </header>

    <!-- 2. SIDEBAR NAVIGATION THEO PHÂN VÙNG -->
    <aside class="sidebar-wrapper" id="sidebar">
        <ul class="sidebar-menu">
            <!-- Trang chủ chung -->
            <li>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["area"] == null && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="bi bi-house-door"></i>
                    <span class="menu-text">Trang chủ cổng trường</span>
                </a>
            </li>

            @* ========================================================= *@
            @* 1. PHÂN VÙNG ADMIN: QUẢN TRỊ TRƯỜNG HỌC & CẤU HÌNH         *@
            @* ========================================================= *@
            @if (User.IsInRole("admin"))
            {
                <div class="sidebar-heading">QUẢN TRỊ HỆ THỐNG</div>
                <li>
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2 text-info"></i>
                        <span class="menu-text">Bảng Quản Trị</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="PhanCong" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "PhanCong" ? "active" : "")">
                        <i class="bi bi-journal-check text-info"></i>
                        <span class="menu-text">Phân Công Giảng Dạy</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="ThoiKhoaBieu" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "ThoiKhoaBieu" ? "active" : "")">
                        <i class="bi bi-calendar3-week text-warning"></i>
                        <span class="menu-text">Lập Thời Khóa Biểu</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="ChuyenCan" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "ChuyenCan" ? "active" : "")">
                        <i class="bi bi-clipboard2-check text-success"></i>
                        <span class="menu-text">Quản Lý Chuyên Cần</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="HocSinh" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "HocSinh" ? "active" : "")">
                        <i class="bi bi-people text-success"></i>
                        <span class="menu-text">Hồ Sơ Học Sinh</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="LopHoc" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "LopHoc" ? "active" : "")">
                        <i class="bi bi-door-open text-primary"></i>
                        <span class="menu-text">Danh Sách Lớp Học</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="GiaoVien" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "GiaoVien" ? "active" : "")">
                        <i class="bi bi-person-badge text-info"></i>
                        <span class="menu-text">Hồ Sơ Giáo Viên</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="MonHoc" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "MonHoc" ? "active" : "")">
                        <i class="bi bi-book text-warning"></i>
                        <span class="menu-text">Danh Mục Môn Học</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="KhoiLop" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "KhoiLop" ? "active" : "")">
                        <i class="bi bi-layers text-secondary"></i>
                        <span class="menu-text">Khối Lớp</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="NamHoc" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "NamHoc" ? "active" : "")">
                        <i class="bi bi-calendar-range text-danger"></i>
                        <span class="menu-text">Năm Học & Học Kỳ</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="TaiKhoan" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "TaiKhoan" ? "active" : "")">
                        <i class="bi bi-key text-light"></i>
                        <span class="menu-text">Quản Lý Tài Khoản</span>
                    </a>
                </li>
            }

            @* ========================================================= *@
            @* 2. PHÂN VÙNG GIÁO VIÊN: PHÂN CÔNG, ĐIỂM DANH, ĐÁNH GIÁ    *@
            @* ========================================================= *@
            @if (User.IsInRole("giao_vien"))
            {
                <div class="sidebar-heading">NGHIỆP VỤ GIÁO VIÊN</div>
                <li>
                    <a asp-area="GiaoVien" asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "GiaoVien" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2 text-warning"></i>
                        <span class="menu-text">Tổng Quan Nghiệp Vụ</span>
                    </a>
                </li>
                <li>
                    <a asp-area="GiaoVien" asp-controller="ThoiKhoaBieu" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "GiaoVien" && ViewContext.RouteData.Values["controller"]?.ToString() == "ThoiKhoaBieu" ? "active" : "")">
                        <i class="bi bi-calendar3-week text-success"></i>
                        <span class="menu-text">Thời Khóa Biểu Giảng Dạy</span>
                    </a>
                </li>
                <li>
                    <a asp-area="GiaoVien" asp-controller="PhanCong" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "GiaoVien" && ViewContext.RouteData.Values["controller"]?.ToString() == "PhanCong" ? "active" : "")">
                        <i class="bi bi-journal-check text-info"></i>
                        <span class="menu-text">Xác Nhận Phân Công</span>
                    </a>
                </li>
                <li>
                    <a asp-area="GiaoVien" asp-controller="LopChuNhiem" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "GiaoVien" && ViewContext.RouteData.Values["controller"]?.ToString() == "LopChuNhiem" ? "active" : "")">
                        <i class="bi bi-people text-light"></i>
                        <span class="menu-text">Lớp Chủ Nhiệm</span>
                    </a>
                </li>
                <li>
                    <a asp-area="GiaoVien" asp-controller="DiemDanh" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "GiaoVien" && ViewContext.RouteData.Values["controller"]?.ToString() == "DiemDanh" ? "active" : "")">
                        <i class="bi bi-calendar-check text-success"></i>
                        <span class="menu-text">Điểm Danh Hàng Ngày</span>
                    </a>
                </li>
                <li>
                    <a asp-area="GiaoVien" asp-controller="DanhGiaMonHoc" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "GiaoVien" && ViewContext.RouteData.Values["controller"]?.ToString() == "DanhGiaMonHoc" ? "active" : "")">
                        <i class="bi bi-pencil-square text-warning"></i>
                        <span class="menu-text">Đánh Giá Môn Học</span>
                    </a>
                </li>
            }

            @* ========================================================= *@
            @* 3. PHÂN VÙNG PHỤ HUYNH: TRA CỨU HỌC TẬP CON EM           *@
            @* ========================================================= *@
            @if (User.IsInRole("phu_huynh"))
            {
                <div class="sidebar-heading">CỔNG PHỤ HUYNH</div>
                <li>
                    <a asp-area="" asp-controller="PhuHuynh" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "PhuHuynh" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer text-info"></i>
                        <span class="menu-text">Tổng Quan Học Tập</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="PhuHuynh" asp-action="BangDiem" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "PhuHuynh" && ViewContext.RouteData.Values["action"]?.ToString() == "BangDiem" ? "active" : "")">
                        <i class="bi bi-journal-check text-success"></i>
                        <span class="menu-text">Bảng Điểm (TT 27)</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="PhuHuynh" asp-action="NangLucPhamChat" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "PhuHuynh" && ViewContext.RouteData.Values["action"]?.ToString() == "NangLucPhamChat" ? "active" : "")">
                        <i class="bi bi-award text-warning"></i>
                        <span class="menu-text">Năng Lực & Phẩm Chất</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="PhuHuynh" asp-action="DiemDanh" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "PhuHuynh" && ViewContext.RouteData.Values["action"]?.ToString() == "DiemDanh" ? "active" : "")">
                        <i class="bi bi-calendar-check text-primary"></i>
                        <span class="menu-text">Chuyên Cần Điểm Danh</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="PhuHuynh" asp-action="ThoiKhoaBieu" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "PhuHuynh" && ViewContext.RouteData.Values["action"]?.ToString() == "ThoiKhoaBieu" ? "active" : "")">
                        <i class="bi bi-calendar3 text-danger"></i>
                        <span class="menu-text">Thời Khóa Biểu Con</span>
                    </a>
                </li>
            }
        </ul>
    </aside>

    <!-- 3. NỘI DUNG CHÍNH (BODY) -->
    <main class="content-wrapper">
        @RenderBody()
    </main>

    <!-- 4. FOOTER -->
    <footer class="main-footer text-center text-muted small">
        &copy; 2026 - Hệ thống Quản lý Học sinh Tiểu học QLHS - Thiết kế chuẩn Thông tư 27 & OR-Tools
    </footer>

    <!-- JS Bootstrap 5 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/loading-overlay.js" asp-append-version="true"></script>
    <script>
        const toggleBtn = document.getElementById('sidebarToggle');
        toggleBtn.addEventListener('click', function () {
            document.body.classList.toggle('sidebar-collapsed');
            const isCollapsed = document.body.classList.contains('sidebar-collapsed');
            localStorage.setItem('sidebar_state', isCollapsed ? 'collapsed' : 'expanded');
        });

        if (localStorage.getItem('sidebar_state') === 'collapsed') {
            document.body.classList.add('sidebar-collapsed');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
