@model IEnumerable<QLHS.Models.DanhGiaMonHoc>

@{
    ViewData["Title"] = "Bảng Điểm & Đánh Giá Môn Học";
    var hocSinh = ViewBag.HocSinhHienTai as QLHS.Models.HocSinh;
    var dsCon = ViewBag.DanhSachCon as List<QLHS.Models.HocSinh>;
    var dsNamHoc = ViewBag.DanhSachNamHoc as List<QLHS.Models.NamHoc>;
    var cauHinhMonKhoi = ViewBag.CauHinhMonKhoi as Dictionary<int, bool> ?? new Dictionary<int, bool>();

    int selectedStudentId = ViewBag.SelectedStudentId;
    int selectedNamHocId = ViewBag.SelectedNamHocId;
    int selectedHocKy = ViewBag.SelectedHocKy;
}

<!-- HEADER VÀ BỘ LỌC TRA CỨU -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h3 class="fw-bold text-primary mb-1">
                    <i class="bi bi-journal-check me-2"></i>BẢNG ĐIỂM & ĐÁNH GIÁ MÔN HỌC
                </h3>
                <p class="text-muted mb-0">Theo dõi kết quả học tập theo Thông tư 27/2020/TT-BGDĐT</p>
            </div>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-print-none">
                <i class="bi bi-printer me-1"></i>In bảng điểm
            </button>
        </div>

        <!-- FORM LỌC ĐA NĂNG (CHỌN CON / CHỌN NĂM HỌC / CHỌN HỌC KỲ) -->
        <form method="get" class="row g-3 pt-2 border-top d-print-none">
            @if (dsCon != null && dsCon.Count > 1)
            {
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">Chọn Học sinh:</label>
                    <select name="studentId" class="form-select fw-bold text-primary" onchange="this.form.submit()">
                        @foreach (var child in dsCon)
                        {
                            <option value="@child.Id" selected="@(child.Id == selectedStudentId)">
                                @child.HoTen (@child.MaHocSinh)
                            </option>
                        }
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" name="studentId" value="@selectedStudentId" />
            }

            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">Năm học:</label>
                <select name="namHocId" class="form-select" onchange="this.form.submit()">
                    @if (dsNamHoc != null)
                    {
                        foreach (var nam in dsNamHoc)
                        {
                            <option value="@nam.Id" selected="@(nam.Id == selectedNamHocId)">
                                Năm học @nam.TenNamHoc
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">Học kỳ:</label>
                <select name="hocKy" class="form-select" onchange="this.form.submit()">
                    <option value="1" selected="@(selectedHocKy == 1)">Học kỳ I</option>
                    <option value="2" selected="@(selectedHocKy == 2)">Học kỳ II</option>
                </select>
            </div>
        </form>
    </div>
</div>

@if (hocSinh != null)
{
    <!-- THÔNG TIN LÝ LỊCH HỌC SINH -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <span class="text-muted d-block small">Họ và tên học sinh:</span>
                    <strong class="fs-5 text-dark">@hocSinh.HoTen</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block small">Mã học sinh:</span>
                    <strong class="text-primary">@hocSinh.MaHocSinh</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block small">Lớp học:</span>
                    <strong class="text-dark">@(hocSinh.LopHocHienTai != null ? "Lớp " + hocSinh.LopHocHienTai.TenLop : "---")</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block small">Khối lớp:</span>
                    <strong class="text-dark">@(hocSinh.LopHocHienTai?.KhoiLop != null ? "Khối " + hocSinh.LopHocHienTai.KhoiLop.SoKhoi : "---")</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG ĐIỂM CHI TIẾT THEO THÔNG TƯ 27 -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-table me-2 text-primary"></i>Kết Quả Đánh Giá Các Môn Học - Học Kỳ @selectedHocKy
            </h5>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2">
                Thông tư 27/2020/TT-BGDĐT
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width: 50px;">STT</th>
                        <th>Tên Môn Học</th>
                        <th style="width: 160px;">Hình Thức Đánh Giá</th>
                        <th style="width: 100px;">Điểm GK</th>
                        <th style="width: 100px;">Điểm CK</th>
                        <th style="width: 160px;">Mức Đánh Giá</th>
                        <th>Nhận Xét Của Giáo Viên</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            bool isDiemSo = item.MonHoc?.HinhThucDanhGia == "diem_nhan_xet";
                            bool coThiGiuaKy = item.MonHocId.HasValue && cauHinhMonKhoi.ContainsKey(item.MonHocId.Value) && cauHinhMonKhoi[item.MonHocId.Value];

                            <tr>
                                <td class="text-center text-muted fw-bold">@(stt++)</td>
                                <td class="fw-bold text-dark">@item.MonHoc?.TenMon</td>
                                <td class="text-center">
                                    @if (isDiemSo)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary small">Điểm số & Nhận xét</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success small">Chỉ nhận xét</span>
                                    }
                                </td>
                                <!-- ĐIỂM GIỮA KỲ -->
                                <td class="text-center fs-6">
                                    @if (isDiemSo && coThiGiuaKy)
                                    {
                                        <span class="fw-bold text-dark">@(item.DiemGiuaKy.HasValue ? item.DiemGiuaKy.Value.ToString("G29") : "-")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <!-- ĐIỂM CUỐI KỲ -->
                                <td class="text-center fs-5">
                                    @if (isDiemSo)
                                    {
                                        <strong class="text-primary">@(item.DiemCuoiKy.HasValue ? item.DiemCuoiKy.Value.ToString("G29") : "-")</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <!-- MỨC ĐÁNH GIÁ (T/H/T) -->
                                <td class="text-center">
                                    @switch (item.MucDanhGia)
                                    {
                                        case "Hoan_thanh_tot":
                                            <span class="badge bg-success px-3 py-2"><i class="bi bi-star-fill me-1"></i>Hoàn thành tốt</span>
                                            break;
                                        case "Hoan_thanh":
                                            <span class="badge bg-info text-dark px-3 py-2"><i class="bi bi-check-circle me-1"></i>Hoàn thành</span>
                                            break;
                                        case "Chua_hoan_thanh":
                                            <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-exclamation-triangle me-1"></i>Chưa hoàn thành</span>
                                            break;
                                        default:
                                            <span class="text-muted small">Chưa đánh giá</span>
                                            break;
                                    }
                                </td>
                                <!-- NHẬN XÉT CỦA GIÁO VIÊN -->
                                <td class="text-muted fst-italic">
                                    @(string.IsNullOrWhiteSpace(item.NhanXetGiaoVien) ? "Chưa có nhận xét." : item.NhanXetGiaoVien)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Chưa có dữ liệu bảng điểm đánh giá cho Học kỳ @selectedHocKy.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- CHÚ THÍCH THÔNG TƯ 27 -->
    <div class="card border-0 bg-white p-3 rounded-3 shadow-sm text-muted small">
        <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle me-1 text-primary"></i>Ghi chú đánh giá theo Thông tư 27/2020/TT-BGDĐT:</div>
        <ul class="mb-0 ps-3">
            <li><strong>Mức đánh giá môn học:</strong> <i>Hoàn thành tốt</i> (Đạt kết quả xuất sắc), <i>Hoàn thành</i> (Đạt yêu cầu môn học), <i>Chưa hoàn thành</i> (Cần cố gắng hỗ trợ).</li>
            <li><strong>Điểm Giữa kỳ (GK):</strong> Áp dụng kiểm tra định kỳ bắt buộc với môn Toán & Tiếng Việt đối với học sinh Khối 4 và Khối 5.</li>
        </ul>
    </div>
}