@model IEnumerable<QLHS.Models.ThoiKhoaBieu>

@{
    ViewData["Title"] = "Thời Khóa Biểu Học Tập";
    var hocSinh = ViewBag.HocSinhHienTai as QLHS.Models.HocSinh;
    var dsCon = ViewBag.DanhSachCon as List<QLHS.Models.HocSinh>;
    int selectedStudentId = ViewBag.SelectedStudentId;
    var banTkbHienHanh = ViewBag.BanTkbHienHanh as QLHS.Models.BanTkb;

    // Tra cứu ô TKB theo KhungTietHoc
    QLHS.Models.ThoiKhoaBieu? GetTkbItem(int thu, int tiet, string buoi)
    {
        if (Model == null) return null;
        return Model.FirstOrDefault(t => 
            t.KhungTiet != null &&
            t.KhungTiet.ThuTrongTuan == thu && 
            t.KhungTiet.TietHoc == tiet && 
            (string.IsNullOrEmpty(t.KhungTiet.BuoiHoc) || t.KhungTiet.BuoiHoc.ToLower() == buoi.ToLower()));
    }

    string GetTenMon(QLHS.Models.ThoiKhoaBieu? item)
    {
        if (item == null) return "";
        return item.MonHoc?.TenMon ?? item.PhanCong?.MonHoc?.TenMon ?? "Môn học";
    }

    string GetTenGiaoVien(QLHS.Models.ThoiKhoaBieu? item)
    {
        if (item == null) return "";
        return item.GiaoVien?.HoTen ?? item.PhanCong?.GiaoVien?.HoTen ?? "";
    }
}

<!-- HEADER & BỘ LỌC HỌC SINH -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h3 class="fw-bold text-info mb-1 text-dark">
                    <i class="bi bi-table me-2 text-info"></i>THỜI KHÓA BIỂU HỌC TẬP
                </h3>
                <p class="text-muted mb-0">
                    Lịch báo giảng môn học hàng tuần của học sinh
                    @if (banTkbHienHanh != null)
                    {
                        <span class="badge bg-success-subtle text-success ms-2">
                            <i class="bi bi-check-circle me-1"></i>Bản công bố số @banTkbHienHanh.SoPhienBan (áp dụng từ @(banTkbHienHanh.TuNgay?.ToString("dd/MM/yyyy") ?? "---"))
                        </span>
                    }
                </p>
            </div>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-print-none">
                <i class="bi bi-printer me-1"></i>In thời khóa biểu
            </button>
        </div>

        @if (dsCon != null && dsCon.Count > 1)
        {
            <form method="get" class="pt-2 border-top d-print-none">
                <div class="row g-3 align-items-center">
                    <div class="col-md-5">
                        <label class="form-label fw-bold small text-muted">Chọn Học sinh:</label>
                        <select name="studentId" class="form-select fw-bold text-info border-info" onchange="this.form.submit()">
                            @foreach (var child in dsCon)
                            {
                                <option value="@child.Id" selected="@(child.Id == selectedStudentId)">
                                    @child.HoTen (@child.MaHocSinh)
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        }
    </div>
</div>

@if (hocSinh != null && hocSinh.LopHocHienTai != null)
{
    <!-- THÔNG TIN LỚP HỌC -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-3">
            <div class="row text-center text-md-start">
                <div class="col-md-4 mb-2 mb-md-0">
                    <span class="text-muted small">Học sinh:</span>
                    <strong class="d-block text-primary">@hocSinh.HoTen (@hocSinh.MaHocSinh)</strong>
                </div>
                <div class="col-md-4 mb-2 mb-md-0">
                    <span class="text-muted small">Lớp:</span>
                    <strong class="d-block text-dark">
                        @hocSinh.LopHocHienTai.TenLop 
                        @(hocSinh.LopHocHienTai.KhoiLop != null ? $" - Khối {hocSinh.LopHocHienTai.KhoiLop.SoKhoi}" : "")
                        @(hocSinh.LopHocHienTai.NamHoc != null ? $" ({hocSinh.LopHocHienTai.NamHoc.TenNamHoc})" : "")
                    </strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small">Giáo viên chủ nhiệm:</span>
                    <strong class="d-block text-success">
                        @(hocSinh.LopHocHienTai.GiaoVienChuNhiem != null ? hocSinh.LopHocHienTai.GiaoVienChuNhiem.HoTen : "Chưa phân công")
                    </strong>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG THỜI KHÓA BIỂU -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th style="width: 100px;">Buổi</th>
                        <th style="width: 80px;">Tiết</th>
                        <th>Thứ 2</th>
                        <th>Thứ 3</th>
                        <th>Thứ 4</th>
                        <th>Thứ 5</th>
                        <th>Thứ 6</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- BUỔI SÁNG (Tiết 1 -> 4) -->
                    @for (int tiet = 1; tiet <= 4; tiet++)
                    {
                        <tr>
                            @if (tiet == 1)
                            {
                                <td rowspan="4" class="fw-bold bg-light text-primary align-middle">
                                    <i class="bi bi-brightness-high me-1"></i>SÁNG
                                </td>
                            }
                            <td class="fw-bold text-muted bg-white">@tiet</td>

                            @for (int thu = 2; thu <= 6; thu++)
                            {
                                var item = GetTkbItem(thu, tiet, "sang");
                                var tenMon = GetTenMon(item);
                                var tenGv = GetTenGiaoVien(item);
                                <td class="p-2" style="height: 65px;">
                                    @if (item != null && !string.IsNullOrEmpty(tenMon))
                                    {
                                        <div class="p-2 rounded bg-light border border-info-subtle h-100 d-flex flex-column justify-content-center">
                                            <strong class="text-dark d-block">@tenMon</strong>
                                            @if (!string.IsNullOrEmpty(tenGv))
                                            {
                                                <small class="text-muted" style="font-size: 0.75rem;">
                                                    <i class="bi bi-person me-1"></i>@tenGv
                                                </small>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted opacity-25">---</span>
                                    }
                                </td>
                            }
                        </tr>
                    }

                    <!-- BUỔI CHIỀU (Tiết 1 -> 3) -->
                    @for (int tiet = 1; tiet <= 3; tiet++)
                    {
                        <tr>
                            @if (tiet == 1)
                            {
                                <td rowspan="3" class="fw-bold bg-light text-warning align-middle">
                                    <i class="bi bi-sunset me-1"></i>CHIỀU
                                </td>
                            }
                            <td class="fw-bold text-muted bg-white">@tiet</td>

                            @for (int thu = 2; thu <= 6; thu++)
                            {
                                var item = GetTkbItem(thu, tiet, "chieu");
                                var tenMon = GetTenMon(item);
                                var tenGv = GetTenGiaoVien(item);
                                <td class="p-2" style="height: 65px;">
                                    @if (item != null && !string.IsNullOrEmpty(tenMon))
                                    {
                                        <div class="p-2 rounded bg-light border border-warning-subtle h-100 d-flex flex-column justify-content-center">
                                            <strong class="text-dark d-block">@tenMon</strong>
                                            @if (!string.IsNullOrEmpty(tenGv))
                                            {
                                                <small class="text-muted" style="font-size: 0.75rem;">
                                                    <i class="bi bi-person me-1"></i>@tenGv
                                                </small>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted opacity-25">---</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning border-0 rounded-4 shadow-sm text-center py-5">
        <i class="bi bi-exclamation-circle text-warning fs-1 mb-2 d-block"></i>
        <h5 class="fw-bold">Chưa có thông tin Thời khóa biểu</h5>
        <p class="text-muted mb-0">Học sinh chưa được xếp vào lớp học hoặc Thời khóa biểu lớp chưa được Ban giám hiệu công bố.</p>
    </div>
}
