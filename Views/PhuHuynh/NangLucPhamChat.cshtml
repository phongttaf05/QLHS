@model QLHS.Models.DanhGiaDinhKyTongHop

@{
    ViewData["Title"] = "Đánh Giá Năng Lực & Phẩm Chất";
    var hocSinh = ViewBag.HocSinhHienTai as QLHS.Models.HocSinh;
    var dsCon = ViewBag.DanhSachCon as List<QLHS.Models.HocSinh>;
    var dsNamHoc = ViewBag.DanhSachNamHoc as List<QLHS.Models.NamHoc>;

    int selectedStudentId = ViewBag.SelectedStudentId;
    int selectedNamHocId = ViewBag.SelectedNamHocId;
    int selectedHocKy = ViewBag.SelectedHocKy;

    // Hàm hỗ trợ render Badge mức đánh giá
    string RenderBadge(string? value)
    {
        switch (value)
        {
            case "Tot":
                return "<span class=\"badge bg-success px-3 py-2 rounded-pill fs-6\"><i class=\"bi bi-star-fill me-1\"></i>Tốt</span>";
            case "Dat":
                return "<span class=\"badge bg-info text-dark px-3 py-2 rounded-pill fs-6\"><i class=\"bi bi-check-circle me-1\"></i>Đạt</span>";
            case "Can_co_gang":
                return "<span class=\"badge bg-warning text-dark px-3 py-2 rounded-pill fs-6\"><i class=\"bi bi-exclamation-triangle me-1\"></i>Cần cố gắng</span>";
            default:
                return "<span class=\"badge bg-secondary bg-opacity-25 text-secondary px-3 py-2 rounded-pill\">Chưa đánh giá</span>";
        }
    }
}

<!-- HEADER VÀ BỘ LỌC -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h3 class="fw-bold text-success mb-1">
                    <i class="bi bi-award me-2"></i>ĐÁNH GIÁ NĂNG LỰC & PHẨM CHẤT
                </h3>
                <p class="text-muted mb-0">Theo dõi sự phát triển toàn diện của học sinh theo Thông tư 27/2020/TT-BGDĐT</p>
            </div>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-print-none">
                <i class="bi bi-printer me-1"></i>In báo cáo
            </button>
        </div>

        <!-- FORM LỌC -->
        <form method="get" class="row g-3 pt-2 border-top d-print-none">
            @if (dsCon != null && dsCon.Count > 1)
            {
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">Chọn Học sinh:</label>
                    <select name="studentId" class="form-select fw-bold text-success" onchange="this.form.submit()">
                        @foreach (var child in dsCon)
                        {
                            <option value="@child.Id" selected="@(child.Id == selectedStudentId)">
                                @child.HoTen (@child.MaHocSinh)
                            </option>
                        }
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" name="studentId" value="@selectedStudentId" />
            }

            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">Năm học:</label>
                <select name="namHocId" class="form-select" onchange="this.form.submit()">
                    @if (dsNamHoc != null)
                    {
                        foreach (var nam in dsNamHoc)
                        {
                            <option value="@nam.Id" selected="@(nam.Id == selectedNamHocId)">
                                Năm học @nam.TenNamHoc
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">Học kỳ:</label>
                <select name="hocKy" class="form-select" onchange="this.form.submit()">
                    <option value="1" selected="@(selectedHocKy == 1)">Học kỳ I</option>
                    <option value="2" selected="@(selectedHocKy == 2)">Học kỳ II</option>
                </select>
            </div>
        </form>
    </div>
</div>

@if (hocSinh != null)
{
    <!-- THÔNG TIN HỌC SINH -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <span class="text-muted d-block small">Họ và tên học sinh:</span>
                    <strong class="fs-5 text-dark">@hocSinh.HoTen</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block small">Mã học sinh:</span>
                    <strong class="text-success">@hocSinh.MaHocSinh</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block small">Lớp học:</span>
                    <strong class="text-dark">@(hocSinh.LopHocHienTai != null ? "Lớp " + hocSinh.LopHocHienTai.TenLop : "---")</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block small">Khối lớp:</span>
                    <strong class="text-dark">@(hocSinh.LopHocHienTai?.KhoiLop != null ? "Khối " + hocSinh.LopHocHienTai.KhoiLop.SoKhoi : "---")</strong>
                </div>
            </div>
        </div>
    </div>

    if (Model != null)
    {
        <!-- SECTION 1: 3 NHÓM NĂNG LỰC CỐT LÕI -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-gear-wide-connected me-2"></i>I. ĐÁNH GIÁ 3 NHÓM NĂNG LỰC CỐT LÕI
                </h5>
            </div>
            <div class="card-body p-4 pt-0">
                <div class="row g-3">
                    <!-- 1. Tự chủ và tự học -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 h-100 bg-light-subtle">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-dark"><i class="bi bi-person-check text-primary me-2"></i>1. Tự chủ và tự học</span>
                            </div>
                            <div class="mt-2 text-center py-2">
                                @Html.Raw(RenderBadge(Model.NangLucTuChuTuHoc))
                            </div>
                            <p class="text-muted small mt-2 mb-0">Tự thực hiện nhiệm vụ học tập, tự giác chuẩn bị đồ dùng học tập.</p>
                        </div>
                    </div>

                    <!-- 2. Giao tiếp và hợp tác -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 h-100 bg-light-subtle">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-dark"><i class="bi bi-people text-success me-2"></i>2. Giao tiếp & hợp tác</span>
                            </div>
                            <div class="mt-2 text-center py-2">
                                @Html.Raw(RenderBadge(Model.NangLucGiaoTiepHopTac))
                            </div>
                            <p class="text-muted small mt-2 mb-0">Lắng nghe, diễn đạt rõ ràng, phối hợp tốt với bạn bè trong làm việc nhóm.</p>
                        </div>
                    </div>

                    <!-- 3. Giải quyết vấn đề và sáng tạo -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 h-100 bg-light-subtle">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-dark"><i class="bi bi-lightbulb text-warning me-2"></i>3. Giải quyết vấn đề</span>
                            </div>
                            <div class="mt-2 text-center py-2">
                                @Html.Raw(RenderBadge(Model.NangLucGiaiQuyetVanDe))
                            </div>
                            <p class="text-muted small mt-2 mb-0">Biết đặt câu hỏi, phát hiện vấn đề và đưa ra giải pháp xử lý linh hoạt.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 2: 5 NHÓM PHẨM CHẤT CHỦ YẾU -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0 text-success">
                    <i class="bi bi-heart-pulse me-2"></i>II. ĐÁNH GIÁ 5 NHÓM PHẨM CHẤT CHỦ YẾU
                </h5>
            </div>
            <div class="card-body p-4 pt-0">
                <div class="row g-3">
                    <!-- 1. Yêu nước -->
                    <div class="col-md-4 col-lg">
                        <div class="p-3 border rounded-3 h-100 text-center">
                            <div class="text-danger fs-3 mb-1"><i class="bi bi-flag-fill"></i></div>
                            <h6 class="fw-bold text-dark mb-2">Yêu nước</h6>
                            <div>@Html.Raw(RenderBadge(Model.PhamChatYeuNuoc))</div>
                        </div>
                    </div>

                    <!-- 2. Nhân ái -->
                    <div class="col-md-4 col-lg">
                        <div class="p-3 border rounded-3 h-100 text-center">
                            <div class="text-primary fs-3 mb-1"><i class="bi bi-heart-fill"></i></div>
                            <h6 class="fw-bold text-dark mb-2">Nhân ái</h6>
                            <div>@Html.Raw(RenderBadge(Model.PhamChatNhanAi))</div>
                        </div>
                    </div>

                    <!-- 3. Chăm chỉ -->
                    <div class="col-md-4 col-lg">
                        <div class="p-3 border rounded-3 h-100 text-center">
                            <div class="text-warning fs-3 mb-1"><i class="bi bi-book-half"></i></div>
                            <h6 class="fw-bold text-dark mb-2">Chăm chỉ</h6>
                            <div>@Html.Raw(RenderBadge(Model.PhamChatChamChi))</div>
                        </div>
                    </div>

                    <!-- 4. Trung thực -->
                    <div class="col-md-4 col-lg">
                        <div class="p-3 border rounded-3 h-100 text-center">
                            <div class="text-info fs-3 mb-1"><i class="bi bi-shield-check"></i></div>
                            <h6 class="fw-bold text-dark mb-2">Trung thực</h6>
                            <div>@Html.Raw(RenderBadge(Model.PhamChatTrungThuc))</div>
                        </div>
                    </div>

                    <!-- 5. Trách nhiệm -->
                    <div class="col-md-4 col-lg">
                        <div class="p-3 border rounded-3 h-100 text-center">
                            <div class="text-success fs-3 mb-1"><i class="bi bi-check-circle-fill"></i></div>
                            <h6 class="fw-bold text-dark mb-2">Trách nhiệm</h6>
                            <div>@Html.Raw(RenderBadge(Model.PhamChatTrachNhiem))</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 3: TỔNG HỢP KHEN THƯỞNG & KẾT QUẢ CỦA LỚP (NẾU CÓ) -->
        @if (!string.IsNullOrEmpty(Model.GoiYKhenThuong) || !string.IsNullOrEmpty(Model.KetQuaCuoiNam))
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-success bg-opacity-10 border border-success">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-success mb-3"><i class="bi bi-trophy me-2"></i>Tổng Kết Đánh Giá & Khen Thưởng</h5>
                    <div class="row g-3">
                        @if (!string.IsNullOrEmpty(Model.KetQuaCuoiNam))
                        {
                            <div class="col-md-6">
                                <span class="text-muted d-block small">Kết quả giáo dục cuối năm:</span>
                                <strong class="fs-6 text-dark">@Model.KetQuaCuoiNam</strong>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.GoiYKhenThuong))
                        {
                            <div class="col-md-6">
                                <span class="text-muted d-block small">Khen thưởng:</span>
                                <span class="badge bg-success text-white fs-6 px-3 py-2">@Model.GoiYKhenThuong</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
            <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
            <h5 class="fw-bold text-secondary">Chưa có dữ liệu đánh giá định kỳ</h5>
            <p class="text-muted">Giáo viên chủ nhiệm chưa cập nhật bảng đánh giá Năng lực & Phẩm chất cho Học kỳ @selectedHocKy.</p>
        </div>
    }

    <!-- GHI CHÚ THÔNG TƯ 27 -->
    <div class="card border-0 bg-white p-3 rounded-3 shadow-sm text-muted small">
        <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle me-1 text-success"></i>Mức đánh giá định kỳ theo Thông tư 27/2020/TT-BGDĐT:</div>
        <ul class="mb-0 ps-3">
            <li><strong>Tốt:</strong> Đáp ứng tốt các yêu cầu biểu hiện về năng lực, phẩm chất.</li>
            <li><strong>Đạt:</strong> Đáp ứng được các yêu cầu biểu hiện về năng lực, phẩm chất.</li>
            <li><strong>Cần cố gắng:</strong> Chưa đáp ứng đầy đủ các yêu cầu biểu hiện về năng lực, phẩm chất, cần sự hỗ trợ của giáo viên & gia đình.</li>
        </ul>
    </div>
}