@{
    ViewData["Title"] = "Từ chối truy cập";
}
<div class="card border-0 shadow-sm rounded-4 text-center py-5 my-5">
    <div class="card-body">
        <i class="bi bi-shield-x text-danger display-1 mb-3"></i>
        <h2 class="text-danger fw-bold">403 - KHÔNG CÓ QUYỀN TRUY CẬP</h2>
